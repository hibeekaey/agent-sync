#!/bin/sh
# agent: synchronize your AI coding agents' memory so you can stop in one
# agent and pick up in another. POSIX sh only, works on macOS and Linux.
#
# Model: `sync` is a round trip. It GATHERS every agent's own memory stores,
# folds them into the synthesized memory file (default: ~/.claude/CLAUDE.md)
# under managed markers, optionally runs a SYNTHESIZER over the result for a
# semantic merge, then REDISTRIBUTES the file to every installed agent's
# global instructions slot. Parity means every agent knows what every agent
# has learned.
set -eu
umask 077

# A synthesizer-spawned agent must never re-enter agent-sync.
if [ "${AGENT_SYNC_ACTIVE:-0}" = "1" ]; then
  exit 0
fi

VERSION="1.7.0"
AGENT_HOME="${AGENT_SYNC_HOME:-$HOME}"
DEFAULT_SRC="$AGENT_HOME/.claude/CLAUDE.md"
SRC="${AGENT_SYNC_SOURCE:-$DEFAULT_SRC}"
TAB=$(printf '\t')
DRY_RUN=0
TARGET_ONLY="${AGENT_SYNC_ONLY:-}"
TARGET_SKIP="${AGENT_SYNC_SKIP:-}"
STATE_DIR="$AGENT_HOME/.config/agent-sync"
PACKS_DIR="$STATE_DIR/packs"
PACKS_LOCK="$STATE_DIR/packs.lock"
MCP_DIR="$STATE_DIR/mcp.d"
MCP_OWNED="$STATE_DIR/mcp-owned"
MCP_APPLIED_DIR="$STATE_DIR/mcp-applied"
SKILLS_OWNED="$STATE_DIR/skills-owned"
SKILLS_SOURCE="${AGENT_SYNC_SKILLS_SOURCE:-$AGENT_HOME/.claude/skills}"
PRIVATE_TMP=""
CANON_TMP=""
APPLY_TMP=""
MANIFEST_TMP=""
TARGET_TMP=""
MCP_TMP=""
SKILL_TMP=""
SKILL_BACKUP=""
SKILL_STATE_TMP=""
IMPORTED_COUNT=0
SYNTHESIZER_REQUEST=""
SYNTHESIZER_FROM_CLI=0

# Colour is strictly additive: the escapes stay empty unless stdout is a
# terminal, so pipes, redirection, cron and CI keep byte-identical output.
# Names are roles rather than hues so the palette is retuned in one place,
# and only status lines wear them -- generated file content, MCP snippets and
# hook recipes are printed plain because they are meant to be pasted or read
# back by another program.
COLOR_MODE=auto
C_OFF=""
C_BOLD=""
C_DIM=""
C_OK=""
C_WARN=""
C_ERR=""
C_PATH=""
C_NUM=""
C_PLAN=""

color_on() { [ -n "$C_OFF" ]; }

# Precedence: an explicit --color/--no-color flag, then FORCE_COLOR or
# CLICOLOR_FORCE, then NO_COLOR (no-color.org), then whether stdout is a
# terminal. TERM is consulted only on that last path: forcing colour into a
# dumb terminal is the caller's business.
color_init() {
  case "$COLOR_MODE" in
    never) return 0 ;;
    always) ;;
    *)
      if [ -n "${FORCE_COLOR:-}" ] && [ "$FORCE_COLOR" != 0 ]; then
        :
      elif [ -n "${CLICOLOR_FORCE:-}" ] && [ "$CLICOLOR_FORCE" != 0 ]; then
        :
      elif [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
        return 0
      else
        case "${TERM:-}" in
          '' | dumb) return 0 ;;
        esac
      fi
      ;;
  esac
  esc=$(printf '\033')
  C_OFF="${esc}[0m"
  C_BOLD="${esc}[1m"
  C_DIM="${esc}[2m"
  C_OK="${esc}[32m"
  C_WARN="${esc}[33m"
  C_ERR="${esc}[31m"
  C_PATH="${esc}[36m"
  C_NUM="${esc}[92m"
  C_PLAN="${esc}[35m"
}

cleanup() {
  [ -z "$CANON_TMP" ] || rm -f "$CANON_TMP"
  [ -z "$APPLY_TMP" ] || rm -f "$APPLY_TMP"
  [ -z "$MANIFEST_TMP" ] || rm -f "$MANIFEST_TMP"
  [ -z "$TARGET_TMP" ] || rm -f "$TARGET_TMP"
  [ -z "$MCP_TMP" ] || rm -f "$MCP_TMP"
  [ -z "$SKILL_TMP" ] || rm -rf "$SKILL_TMP"
  [ -z "$SKILL_BACKUP" ] || rm -rf "$SKILL_BACKUP"
  [ -z "$SKILL_STATE_TMP" ] || rm -f "$SKILL_STATE_TMP"
  [ -z "$PRIVATE_TMP" ] || rm -rf "$PRIVATE_TMP"
}

trap cleanup 0
trap 'exit 1' HUP INT TERM

ensure_private_tmp() {
  if [ -z "$PRIVATE_TMP" ]; then
    PRIVATE_TMP=$(mktemp -d "${TMPDIR:-/tmp}/agent-sync.XXXXXXXX") || {
      echo "${C_ERR}agent:${C_OFF} could not create a private temporary directory" >&2
      exit 1
    }
  fi
}

usage() {
  cat <<EOF
agent v$VERSION: synchronize agent memory across AI coding agents

Usage:
  agent sync [--synthesizer MODE] [--dry-run]
                         gather every agent's memory stores, synthesize them,
                         and redistribute to all installed agents
  agent status           per-agent parity check (exit 1 if anything is stale)
  agent diff             show stale targets as unified diffs (exit 1 if any)
  agent targets          list sync targets and whether each tool is installed
  agent doctor           diagnose the setup and report problems
  agent migrate AGENT    fold just one agent's memory stores in, then
                         redistribute
  agent gather [DIR]     stage every agent's memory stores into DIR
                         (default: ./agent-memories) for editing and review
  agent apply [DIR] [--synthesizer MODE] [--dry-run]
                         push edited staged files from a gather DIR back to
                         their original stores, then run the full sync
  agent link [DIR] [--import]
                         make one project-scope AGENTS.md readable by every
                         agent in a repository; --import folds the repo's
                         native per-tool configs into it
  agent revert           restore targets from their .orig adoption backups
                         and the synthesized file from its .bak
  agent pack <add|list|update|remove>
                         shareable markdown memory packs pulled from GitHub
                         at a pinned commit, folded in on every sync
  agent mcp <add|list|remove|sync|snippet>
                         one MCP server registry pushed to every tool, via
                         its own CLI (claude, codex, gemini, qwen, amp) or
                         an agent-sync-owned config file (cursor, windsurf,
                         kiro)
  agent skills sync      additively synchronize the canonical skills directory
                         (default ~/.claude/skills) into every agent's
                         user-scope skills directory
  agent compact [--budget BYTES] [--synthesizer MODE] [--force] [--keep-all]
                [--dry-run]
                         keep the synthesized file under a byte budget:
                         promote raw imports into curated notes (archiving
                         their stores) and rewrite oversized sections
                         shorter, one at a time. A rewrite may forget how a
                         lesson was learned, settled items and one-off
                         references, but is refused if it drops a real URL,
                         a hostname, an environment variable or a long id;
                         --keep-all forbids forgetting and protects every
                         backtick span and bare letter-and-digit token
  agent hooks [TOOL]     print verified automation snippets that keep memory
                         fresh (claude, codex, gemini, opencode, launchd)
  agent help             this text

Target filtering: --only LIST / --skip LIST flags (sync, apply) or the
AGENT_SYNC_ONLY / AGENT_SYNC_SKIP env vars, comma-separated target names.

Colour: status output is coloured on a terminal and plain everywhere else,
so pipes, cron and CI are unchanged. --no-color (or NO_COLOR) turns it off,
--color=always (or FORCE_COLOR) keeps it through a pipe or a pager.

The edit loop: agent gather, edit the staged files, agent apply. Your edits
land in the original stores, get folded into the synthesized file, and are
redistributed to every agent.

The first time sync overwrites a pre-existing file agent-sync did not write,
the original is kept beside it as <file>.orig; agent revert restores them.

Agents with readable memory stores: claude, codex, cursor, continue,
windsurf, goose.

Synthesized memory file: $SRC (override with AGENT_SYNC_SOURCE)
Agent configuration root: $AGENT_HOME (override with AGENT_SYNC_HOME)
Synthesis modes: auto (default), claude, codex, deterministic. Auto tries
Claude, then Codex, then keeps the deterministic merge. Select a mode with
--synthesizer MODE or AGENT_SYNC_SYNTHESIZER. The environment variable also
accepts a custom command that reads a merge prompt and prints the document:
  AGENT_SYNC_SYNTHESIZER='claude -p' agent sync

Size budget: the synthesized file is read into every session on every tool,
so sync, status and doctor report its size against AGENT_SYNC_BUDGET
(default $COMPACT_BUDGET_DEFAULT bytes) and agent compact brings it back under. compact
needs a model (claude, codex or a custom command); it exits immediately
while the file is within budget, so it is cheap to schedule.

Tools are detected by their config directory; absent tools are skipped, so
one binary serves every machine.
EOF
}

# name|detect dir|destination|mode
targets() {
  if [ "$SRC" != "$DEFAULT_SRC" ]; then
    printf 'claude|%s|%s|copy\n' "$AGENT_HOME/.claude" "$DEFAULT_SRC"
  fi
  cat <<EOF
codex|$AGENT_HOME/.codex|$AGENT_HOME/.codex/AGENTS.md|copy
gemini|$AGENT_HOME/.gemini|$AGENT_HOME/.gemini/GEMINI.md|copy
qwen|$AGENT_HOME/.qwen|$AGENT_HOME/.qwen/QWEN.md|copy
continue|$AGENT_HOME/.continue|$AGENT_HOME/.continue/rules/best-practices.md|copy
windsurf|$AGENT_HOME/.codeium|$AGENT_HOME/.codeium/windsurf/memories/global_rules.md|copy
cursor|$AGENT_HOME/.cursor|$AGENT_HOME/.cursor/rules/best-practices.mdc|cursor
opencode|$AGENT_HOME/.config/opencode|$AGENT_HOME/.config/opencode/AGENTS.md|copy
amp|$AGENT_HOME/.config/amp|$AGENT_HOME/.config/amp/AGENTS.md|copy
goose|$AGENT_HOME/.config/goose|$AGENT_HOME/.config/goose/.goosehints|copy
copilot|$AGENT_HOME/.copilot|$AGENT_HOME/.copilot/copilot-instructions.md|copy
zed|$AGENT_HOME/.config/zed|$AGENT_HOME/.config/zed/AGENTS.md|copy
junie|$AGENT_HOME/.junie|$AGENT_HOME/.junie/AGENTS.md|copy
kiro|$AGENT_HOME/.kiro|$AGENT_HOME/.kiro/steering/agent-sync.md|copy
crush|$AGENT_HOME/.config/crush|$AGENT_HOME/.config/crush/CRUSH.md|copy
roo|$AGENT_HOME/.roo|$AGENT_HOME/.roo/rules/agent-sync.md|copy
cline|$AGENT_HOME/Documents/Cline|$AGENT_HOME/Documents/Cline/Rules/agent-sync.md|copy
EOF
}

NL='
'

# Resolve a directory to its physical path (symlinks resolved).
physical_path() {
  (CDPATH='' cd -P "$1" 2>/dev/null && pwd -P)
}

# Registry names (packs, MCP servers) become file paths; keep them to one
# safe path segment.
require_safe_name() {
  case "$1" in
    "" | */* | .* | *"$NL"*)
      echo "${C_ERR}agent:${C_OFF} unsafe name: $1" >&2
      exit 2
      ;;
  esac
}

# Imported content must never be able to open or close our managed markers.
neutralize_markers() {
  sed 's/<!-- agent-sync:/<!-- agent-sync (escaped):/g' "$1"
}

# Per-agent targeting: --only/--skip flags and AGENT_SYNC_ONLY/AGENT_SYNC_SKIP
# env vars hold comma-separated target names.
target_selected() {
  if [ -n "$TARGET_ONLY" ]; then
    case ",$TARGET_ONLY," in
      *",$1,"*) ;;
      *) return 1 ;;
    esac
  fi
  case ",$TARGET_SKIP," in
    *",$1,"*) return 1 ;;
  esac
  return 0
}

# Cursor rules need .mdc frontmatter around the same body.
cursor_render() {
  printf -- '---\ndescription: Global agent memory managed by agent-sync (run: agent sync)\nalwaysApply: true\n---\n\n'
  cat "$SRC"
}

sum() {
  cksum <"$1" | awk '{print $1 ":" $2}'
}

require_src() {
  if [ ! -f "$SRC" ]; then
    echo "${C_ERR}agent:${C_OFF} synthesized memory file not found: $SRC" >&2
    echo "create it (or point AGENT_SYNC_SOURCE at yours), then re-run" >&2
    exit 1
  fi
}

# Emit the memory-store file paths an agent owns. Files agent-sync itself
# generates are excluded (they are copies of the synthesized file), as are
# index files (Claude's MEMORY.md is an index of the real memory files).
sources_for() {
  case "$1" in
    claude)
      for f in "$AGENT_HOME"/.claude/projects/*/memory/*.md; do
        [ -f "$f" ] || continue
        [ "$f" = "$SRC" ] && continue
        case "$(basename "$f")" in MEMORY.md) continue ;; esac
        echo "$f"
      done
      ;;
    codex)
      for f in "$AGENT_HOME"/.codex/memories/*.md; do
        [ -f "$f" ] || continue
        [ "$f" = "$SRC" ] || echo "$f"
      done
      ;;
    cursor)
      for f in "$AGENT_HOME"/.cursor/rules/*.mdc "$AGENT_HOME"/.cursor/rules/*.md; do
        [ -f "$f" ] || continue
        [ "$f" = "$SRC" ] && continue
        case "$(basename "$f")" in best-practices.mdc | best-practices.md) continue ;; esac
        echo "$f"
      done
      ;;
    continue)
      for f in "$AGENT_HOME"/.continue/rules/*.md; do
        [ -f "$f" ] || continue
        [ "$f" = "$SRC" ] && continue
        case "$(basename "$f")" in best-practices.md) continue ;; esac
        echo "$f"
      done
      ;;
    windsurf)
      for f in "$AGENT_HOME"/.codeium/windsurf/memories/*.md; do
        [ -f "$f" ] || continue
        [ "$f" = "$SRC" ] && continue
        case "$(basename "$f")" in global_rules.md) continue ;; esac
        echo "$f"
      done
      ;;
    goose)
      # Goose's Memory extension stores plain text files, one per category.
      for f in "$AGENT_HOME"/.config/goose/memory/*.md "$AGENT_HOME"/.config/goose/memory/*.txt; do
        [ -f "$f" ] || continue
        [ "$f" = "$SRC" ] || echo "$f"
      done
      ;;
    *)
      echo "${C_ERR}agent:${C_OFF} unknown agent: $1 (try: claude, codex, cursor, continue, windsurf, goose)" >&2
      return 2
      ;;
  esac
}

# Replace (or append) the marker-delimited import section for one agent
# inside the synthesized file. Deterministic: unchanged stores produce a
# byte-identical document.
validate_import_section() {
  from="$1"
  begin="<!-- agent-sync:begin imported:$from -->"
  end="<!-- agent-sync:end imported:$from -->"
  if ! awk -v b="$begin" -v e="$end" '
    $0 == b {
      begins++
      if (open || begins > 1 || ends > 0) bad = 1
      open = 1
    }
    $0 == e {
      ends++
      if (!open || ends > 1) bad = 1
      open = 0
    }
    END { if (bad || open || begins != ends) exit 1 }
  ' "$SRC"; then
    echo "${C_ERR}agent:${C_OFF} malformed import markers for $from in $SRC; refusing to modify it" >&2
    return 1
  fi
}

import_into_canon() {
  from="$1"
  content="$2"
  found="$3"
  begin="<!-- agent-sync:begin imported:$from -->"
  end="<!-- agent-sync:end imported:$from -->"
  has_section=0
  grep -qxF "$begin" "$SRC" && has_section=1
  if [ "$has_section" -eq 0 ] && [ "$found" -eq 0 ]; then
    return
  fi
  if [ "$DRY_RUN" -eq 1 ]; then
    if [ "$found" -gt 0 ]; then
      echo "dry-run: would refresh section imported:$from in $SRC"
    else
      echo "dry-run: would remove section imported:$from from $SRC"
    fi
    return
  fi
  CANON_TMP=$(mktemp "$(dirname "$SRC")/.agent-sync.XXXXXXXX") || {
    echo "${C_ERR}agent:${C_OFF} could not create a temporary file beside $SRC" >&2
    exit 1
  }
  if [ "$has_section" -eq 1 ] && [ "$found" -gt 0 ]; then
    awk -v b="$begin" -v e="$end" -v f="$content" '
      $0 == b { print; while ((getline line < f) > 0) print line; skip = 1; next }
      $0 == e { skip = 0; print; next }
      !skip { print }
    ' "$SRC" >"$CANON_TMP"
  elif [ "$has_section" -eq 1 ]; then
    awk -v b="$begin" -v e="$end" '
      $0 == b { skip = 1; next }
      $0 == e { skip = 0; next }
      !skip { print }
    ' "$SRC" >"$CANON_TMP"
  else
    {
      cat "$SRC"
      printf '\n%s\n' "$begin"
      cat "$content"
      printf '%s\n' "$end"
    } >"$CANON_TMP"
  fi
  mv "$CANON_TMP" "$SRC"
  CANON_TMP=""
}

# Fold one agent's memory stores into the synthesized file.
import_agent() {
  from="$1"
  ensure_private_tmp
  content="$PRIVATE_TMP/import-$from"
  list="$PRIVATE_TMP/import-list-$from"
  {
    echo "## Memories imported from $from"
    echo
    echo "Raw import, refreshed on every sync. Ask your agent to consolidate"
    echo "the durable parts into the curated sections and prune duplicates."
  } >"$content"
  sources_for "$from" >"$list"
  found=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    {
      echo
      echo "### $f"
      echo
      neutralize_markers "$f"
      printf '\n'
    } >>"$content"
    found=$((found + 1))
  done <"$list"
  import_into_canon "$from" "$content" "$found"
  IMPORTED_COUNT="$found"
}

parse_synthesizer_args() {
  SYNTHESIZER_REQUEST="${AGENT_SYNC_SYNTHESIZER:-auto}"
  SYNTHESIZER_FROM_CLI=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --synthesizer)
        shift
        if [ "$#" -eq 0 ]; then
          echo "${C_ERR}agent:${C_OFF} --synthesizer requires a mode" >&2
          return 2
        fi
        SYNTHESIZER_REQUEST="$1"
        SYNTHESIZER_FROM_CLI=1
        ;;
      --synthesizer=*)
        SYNTHESIZER_REQUEST=${1#*=}
        SYNTHESIZER_FROM_CLI=1
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      --only)
        shift
        if [ "$#" -eq 0 ]; then
          echo "${C_ERR}agent:${C_OFF} --only requires a comma-separated target list" >&2
          return 2
        fi
        TARGET_ONLY="$1"
        ;;
      --only=*)
        TARGET_ONLY=${1#*=}
        ;;
      --skip)
        shift
        if [ "$#" -eq 0 ]; then
          echo "${C_ERR}agent:${C_OFF} --skip requires a comma-separated target list" >&2
          return 2
        fi
        TARGET_SKIP="$1"
        ;;
      --skip=*)
        TARGET_SKIP=${1#*=}
        ;;
      *)
        echo "${C_ERR}agent:${C_OFF} unknown sync option: $1" >&2
        return 2
        ;;
    esac
    shift
  done
  validate_synthesizer_request
}

validate_synthesizer_request() {
  case "$SYNTHESIZER_REQUEST" in
    auto | claude | codex | deterministic) ;;
    *)
      if [ "$SYNTHESIZER_FROM_CLI" -eq 1 ]; then
        echo "${C_ERR}agent:${C_OFF} unknown synthesizer mode: $SYNTHESIZER_REQUEST" >&2
        return 2
      fi
      ;;
  esac
}

require_selected_synthesizer() {
  case "$SYNTHESIZER_REQUEST" in
    claude | codex)
      if ! command -v "$SYNTHESIZER_REQUEST" >/dev/null 2>&1; then
        echo "${C_ERR}agent:${C_OFF} requested synthesizer is not installed: $SYNTHESIZER_REQUEST" >&2
        return 1
      fi
      ;;
  esac
}

# Shrinking is the point of a synthesis: it folds the imported sections away,
# and a real one measured 45% of its input. A refusal measured 2%. The floor
# sits between them, an order of magnitude clear of a refusal and well under
# a genuine merge, because accepting a refusal replaces the memory file and
# pushes the stub to every agent before anyone notices. Recovery is the .bak,
# which is a worse answer than not accepting it.
SYNTH_MIN_PERCENT=25

valid_synth_output() {
  vs_out="$1"
  vs_src="$2"
  [ -s "$vs_out" ] || return 1
  head -1 "$vs_out" | grep -q '^#' || return 1
  [ -n "$vs_src" ] && [ -f "$vs_src" ] || return 0
  vs_src_lines=$(wc -l <"$vs_src" | tr -d ' ')
  [ "$vs_src_lines" -gt 0 ] || return 0
  vs_out_lines=$(wc -l <"$vs_out" | tr -d ' ')
  if [ $((vs_out_lines * 100)) -lt $((vs_src_lines * SYNTH_MIN_PERCENT)) ]; then
    echo "${C_ERR}agent:${C_OFF} synthesis returned $vs_out_lines lines from $vs_src_lines; refusing to replace $vs_src with it" >&2
    return 1
  fi
}

# A synthesizer sometimes opens with a line of chat before the document.
# Dropping that line beats throwing away an otherwise correct merge of a
# 60 KB file, but only inside a short window: prose running longer than this
# means the model answered something other than "rewrite this document", and
# the deterministic merge already in place is the better answer.
SYNTH_PREAMBLE_MAX=10

strip_synth_preamble() {
  sp_out="$1"
  if head -1 "$sp_out" | grep -q '^#'; then
    return 0
  fi
  sp_at=$(awk -v max="$SYNTH_PREAMBLE_MAX" '
    NR > max { exit }
    /^#/ { print NR; exit }
  ' "$sp_out")
  [ -n "$sp_at" ] || return 0
  ensure_private_tmp
  tail -n +"$sp_at" "$sp_out" >"$PRIVATE_TMP/synth-trimmed"
  cp "$PRIVATE_TMP/synth-trimmed" "$sp_out"
}

# Run one model call: the prompt on stdin, the document on stdout. Shared by
# the whole-document synthesis and by compact's per-section rewrites, so the
# vendor flags live in exactly one place.
invoke_synthesizer() {
  kind="$1"
  prompt="$2"
  out="$3"
  : >"$out"
  run_status=0
  case "$kind" in
    claude)
      AGENT_SYNC_ACTIVE=1 claude -p --no-session-persistence \
        --permission-mode dontAsk <"$prompt" >"$out" || run_status=$?
      ;;
    codex)
      AGENT_SYNC_ACTIVE=1 codex exec --skip-git-repo-check \
        --sandbox read-only --ephemeral --color never - <"$prompt" >"$out" ||
        run_status=$?
      ;;
    custom)
      AGENT_SYNC_ACTIVE=1 sh -c "$SYNTHESIZER_REQUEST" <"$prompt" >"$out" ||
        run_status=$?
      ;;
  esac
  [ "$run_status" -eq 0 ]
}

try_synthesizer() {
  kind="$1"
  prompt="$2"
  out="$3"
  invoke_synthesizer "$kind" "$prompt" "$out" || return 1
  strip_synth_preamble "$out"
  valid_synth_output "$out" "$SRC" || return 1
  ensure_private_tmp
  identifier_source "$SRC" >"$PRIVATE_TMP/synth-ids"
  ts_missing=$(missing_identifiers "$PRIVATE_TMP/synth-ids" "$out")
  if [ -n "$ts_missing" ]; then
    ts_count=$(printf '%s\n' "$ts_missing" | grep -c .)
    echo "${C_ERR}agent:${C_OFF} synthesis dropped $ts_count identifier(s) the document carries, e.g. $(printf '%s\n' "$ts_missing" | head -3 | tr '\n' ' '); refusing to replace $SRC with it" >&2
    return 1
  fi
}

accept_synth_output() {
  kind="$1"
  out="$2"
  CANON_TMP=$(mktemp "$(dirname "$SRC")/.agent-sync.XXXXXXXX") || {
    echo "${C_ERR}agent:${C_OFF} could not create a temporary file beside $SRC" >&2
    exit 1
  }
  cp "$out" "$CANON_TMP"
  cp "$SRC" "$SRC.bak"
  mv "$CANON_TMP" "$SRC"
  CANON_TMP=""
  echo "${C_PLAN}synthesized via: $kind${C_OFF} ${C_DIM}(previous file at $SRC.bak)${C_OFF}"
}

synthesize() {
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "${C_PLAN}dry-run: would synthesize (mode: $SYNTHESIZER_REQUEST)${C_OFF}"
    return
  fi
  if [ "$SYNTHESIZER_REQUEST" = "deterministic" ]; then
    echo "${C_PLAN}synthesis: deterministic merge${C_OFF}"
    return
  fi
  if [ "$SYNTHESIZER_REQUEST" = "auto" ] &&
    ! command -v claude >/dev/null 2>&1 &&
    ! command -v codex >/dev/null 2>&1; then
    echo "${C_PLAN}synthesis: deterministic merge${C_OFF} ${C_DIM}(Claude and Codex not installed)${C_OFF}"
    return
  fi
  ensure_private_tmp
  prompt="$PRIVATE_TMP/synth-prompt"
  out="$PRIVATE_TMP/synth-out"
  {
    cat <<'EOF'
You are the memory synthesizer for agent-sync. Below is the synthesized
memory file for this machine's AI coding agents. It contains curated
sections plus marker-delimited sections of raw memories imported from
individual agents. Rewrite the whole document: fold the durable,
non-duplicated facts from the imported sections into the curated sections,
drop noise and duplicates, resolve conflicts in favor of the newest
information, keep the document's structure and voice, and remove the
imported sections you fold in.
$(compact_keep_rules)
Print ONLY the new markdown document.
EOF
    echo
    echo '--- DOCUMENT ---'
    cat "$SRC"
  } >"$prompt"
  case "$SYNTHESIZER_REQUEST" in
    auto)
      for kind in claude codex; do
        command -v "$kind" >/dev/null 2>&1 || continue
        if try_synthesizer "$kind" "$prompt" "$out"; then
          accept_synth_output "$kind" "$out"
          return
        fi
        echo "${C_ERR}agent:${C_OFF} $kind synthesis failed; trying the next fallback" >&2
      done
      echo "${C_PLAN}synthesis: deterministic merge${C_OFF} ${C_DIM}(no usable Claude or Codex)${C_OFF}"
      return
      ;;
    claude | codex)
      if try_synthesizer "$SYNTHESIZER_REQUEST" "$prompt" "$out"; then
        accept_synth_output "$SYNTHESIZER_REQUEST" "$out"
      else
        echo "${C_ERR}agent:${C_OFF} $SYNTHESIZER_REQUEST synthesis failed; keeping the deterministic merge" >&2
      fi
      ;;
    *)
      if try_synthesizer custom "$prompt" "$out"; then
        accept_synth_output "$SYNTHESIZER_REQUEST" "$out"
      else
        echo "${C_ERR}agent:${C_OFF} custom synthesizer failed; keeping the deterministic merge" >&2
      fi
      ;;
  esac
}

# ---- compaction ------------------------------------------------------------
# The synthesized file is read into every session on every tool, so its size
# is a cost paid on every turn, and the deterministic import grows it by the
# full text of every store on every sync. `compact` keeps it under a byte
# budget. Raw imported sections are promoted into curated notes and their
# store files archived, so the next sync has nothing to re-import; oversized
# curated sections are rewritten shorter by a model, one section at a time.
# Every rewrite is gated: the heading must survive, the result must not be a
# refusal-sized stub, and every name, path, URL, id and number of the original
# must still appear, because a summary that loses an identifier has lost the
# one thing an agent cannot re-derive.
COMPACT_BUDGET_DEFAULT=150000
COMPACT_HEADROOM_PERCENT=95    # aim below the budget so the next import fits
COMPACT_MIN_SECTION_BYTES=2048 # smaller sections are not worth a model call
COMPACT_MIN_RATIO_PERCENT=30   # never ask one pass to cut a section harder
COMPACT_SECTION_FLOOR_PERCENT=25 # a rewrite smaller than this is a refusal
COMPACT_IMPORT_FLOOR_PERCENT=8 # imports carry frontmatter and headers to drop
COMPACT_OVERSHOOT_PERCENT=125  # accept a rewrite up to this far over target
COMPACT_FORCE=0
COMPACT_BUDGET=""
# What a rewrite must keep. `stable` (the default) hard-protects only what
# routes traffic or unlocks access and cannot be re-derived: real URLs and
# hostnames, environment variable names, and long ids (tags, tables, streams,
# accounts). Paths, commands and code words are asked for in the prompt but
# may go with a story the rewrite forgets, as may one-off references (commit
# shas, PR and issue numbers, past versions, dates). `strict` (--keep-all)
# protects every backtick span and every bare letter-and-digit token, and
# forbids forgetting.
COMPACT_MODE=stable

compact_budget() {
  cb="${COMPACT_BUDGET:-${AGENT_SYNC_BUDGET:-$COMPACT_BUDGET_DEFAULT}}"
  case "$cb" in
    '' | *[!0-9]* | 0)
      echo "${C_ERR}agent:${C_OFF} budget must be a positive number of bytes: $cb" >&2
      return 2
      ;;
  esac
  echo "$cb"
}

file_bytes() {
  wc -c <"$1" | tr -d ' '
}

# One line on the synthesized file's size. Returns 1 when it is over budget.
budget_report() {
  br_budget=$(compact_budget) || return 2
  br_bytes=$(file_bytes "$SRC")
  if [ "$br_bytes" -gt "$br_budget" ]; then
    echo "${C_WARN}synthesized file is $br_bytes bytes, over the $br_budget-byte budget; run: agent compact${C_OFF}"
    return 1
  fi
  echo "${C_DIM}synthesized file: $br_bytes of $br_budget bytes${C_OFF}"
}

# Everything in a document an agent cannot re-derive: backtick spans, URLs,
# and bare tokens that mix letters and digits (ids, versions, shas, keys).
# Backticks are paired across the whole file, not per line, so a span broken
# across two lines is one span and the prose between it and the next span is
# not; each line of a multi-line span must survive on its own. A span carrying
# an em dash is a pairing accident, not an identifier. A number glued to a
# lowercase word (146-account, 429ing) is prose a rewrite may rephrase. Each
# grep ends in `|| true`: the script runs under set -e, and a section with no
# URL would otherwise abort the group before the bare tokens are read.
extract_identifiers() {
  ei_mode="${2:-$COMPACT_MODE}"
  bt=$(printf '\140')
  {
    awk -v bt="$bt" '
      { buf = buf $0 "\001" }
      END {
        # split() always breaks on newlines too, so they are masked first.
        n = split(buf, seg, bt)
        for (i = 2; i <= n; i += 2) {
          m = split(seg[i], part, "\001")
          for (j = 1; j <= m; j++) {
            s = part[j]
            gsub(/^[ \t]+/, "", s)
            gsub(/[ \t]+$/, "", s)
            if (length(s) > 0 && length(s) <= 200) print s
          }
        }
      }
    ' "$1" | grep -v ' — ' || true
    grep -oE 'https?://[^] )>"`'"'"']+' "$1" || true
    if [ "$ei_mode" = strict ]; then
      grep -oE '[A-Za-z0-9][A-Za-z0-9._/:-]{5,}' "$1" | grep -E '[0-9]' | grep -E '[A-Za-z]' |
        grep -vE '^[0-9]+-?[a-z]+$' || true
    fi
  } 2>/dev/null | sed 's/[.:/,;-]*$//' | awk 'length($0) > 0' | {
    if [ "$ei_mode" = strict ]; then
      cat
    else
      stable_identifiers_only
    fi
  } | LC_ALL=C sort -u
}

# The stable subset: URLs other than localhost and example hosts; hostnames
# (a dotted lowercase name ending in a real TLD, so tokens.ts is not one);
# UPPER_SNAKE names of two or more segments (environment variables); and ids
# of eight or more characters mixing letters and digits with no space. One-off
# references never count, whatever else they match: commit shas, PR and issue
# numbers, version numbers, dates.
stable_identifiers_only() {
  grep -vE '^[0-9a-f]{6,40}$|^#?[0-9]+$|^v?[0-9]+(\.[0-9]+)+([-.][A-Za-z0-9]+)*$|^[0-9]{4}-[0-9]{2}-[0-9]{2}$' |
    awk '
      /^https?:\/\/(localhost|127\.0\.0\.1|0\.0\.0\.0|[a-z0-9.-]*example\.[a-z]+)([:\/]|$)/ { next }
      /^https?:\/\// { print; next }
      /^[a-z0-9-]+(\.[a-z0-9-]+)*\.(io|com|org|net|app|dev|cloud|co|ai|me|ng|us|uk|de|fr|eu|sh|xyz|info|biz|tv|gg|so|to|ly)$/ { print; next }
      /^[A-Z][A-Z0-9]*(_[A-Z0-9]+)+$/ { print; next }
      length($0) >= 8 && /[0-9]/ && /[A-Za-z]/ && /^[A-Za-z0-9._@:+-]+$/ { print; next }
    ' || true
}

# The text whose identifiers a rewrite must keep: the document minus the
# import path headers and store frontmatter a merge is told to drop.
identifier_source() {
  awk '
    /^### \// { next }
    /^---$/ { fm = !fm; next }
    !fm { print }
  ' "$1"
}

# Print every identifier of $1 that $2 no longer contains.
missing_identifiers() {
  extract_identifiers "$1" "${3:-$COMPACT_MODE}" | while IFS= read -r mi_id; do
    grep -qF -- "$mi_id" "$2" || printf '%s\n' "$mi_id"
  done
}

# Split $SRC into $1/chunk-NNNN files: a head (before the first "## "), one
# chunk per "## " section, and one chunk per marker-delimited import block
# (markers included). $1/manifest lists "index|kind" in order.
compact_split() {
  cs_dir="$1"
  awk -v dir="$cs_dir" '
    function start(kind) {
      if (n > 0) close(file)
      n++
      file = sprintf("%s/chunk-%04d", dir, n)
      printf "" > file
      kinds[n] = kind
    }
    BEGIN { n = 0; start("head"); inimport = 0 }
    /^<!-- agent-sync:begin imported:/ {
      from = $0
      sub(/^<!-- agent-sync:begin imported:/, "", from)
      sub(/ -->$/, "", from)
      start("import:" from)
      inimport = 1
      print > file
      next
    }
    /^<!-- agent-sync:end imported:/ {
      print > file
      inimport = 0
      start("gap")
      next
    }
    /^## / && !inimport { start("section"); print > file; next }
    { print > file }
    END {
      close(file)
      for (i = 1; i <= n; i++) print i "|" kinds[i]
    }
  ' "$SRC" >"$cs_dir/manifest"
}

# The keep/forget rules shared by every prompt, in the selected mode.
compact_keep_rules() {
  if [ "$COMPACT_MODE" = strict ]; then
    cat <<'EOF'
- Keep every rule, decision, owner ruling, fact, identifier, number, date,
  version, path, URL, command and name. Anything inside backticks must
  survive verbatim. Never paraphrase an identifier.
- Remove repetition, narrative, anecdotes, and rationale that only restates
  the rule. Keep a rationale only where the rule is not self-evident without
  it. Merge duplicated points. Prefer tight bullets and tables.
EOF
    return
  fi
  cat <<'EOF'
- Keep every CURRENT rule, decision and fact an agent needs to act on this
  machine, and keep every hostname, URL, file path, command, environment
  variable, account, tag, table and stream id, name and price exactly as
  written. Anything inside backticks survives verbatim unless it is a commit
  sha, a PR or issue number, a run id or a past version number.
- You MAY forget, and should when it buys space: how a lesson was learned
  (session narratives, dates of discovery, quoted remarks, counts of
  corrections); items marked settled, refuted, muted, parked or "do not
  re-raise" (drop them entirely); one-off references (commit shas, PR and
  issue numbers, run ids, superseded versions); and anything else you judge
  of low value to an agent doing this work in future. Never soften or
  generalise a rule that stays.
- Merge duplicated points. Prefer tight bullets and tables.
EOF
}

compact_section_prompt() {
  cat <<EOF
You are compacting one section of the memory file that agent-sync
distributes to every AI coding agent on this machine. The section below is
$2 bytes; rewrite it to at most $3 bytes.

Rules:
- The first line is the heading. Keep it exactly as it is.
$(compact_keep_rules)
- Do not add anything.
- Print ONLY the rewritten markdown section, starting with the heading.
EOF
  if [ -n "$4" ]; then
    echo
    echo "Your previous attempt was $4 bytes, which is too long. It must be at most $3 bytes."
  fi
  if [ -n "$5" ]; then
    echo
    echo "Your previous attempt dropped the following, each of which must appear verbatim in the rewrite:"
    printf '%s\n' "$5" | sed 's/^/- /'
  fi
  echo
  echo '--- SECTION ---'
  cat "$1"
}

compact_import_prompt() {
  cat <<EOF
You are compacting the memory file that agent-sync distributes to every AI
coding agent on this machine. The section below is a raw import of the
memory store files of one agent ($4), copied verbatim, $2 bytes in total.
Turn it into curated notes of at most $3 bytes.

Rules:
- The first line of your output must be exactly: ## Promoted from $4 ($5)
$(compact_keep_rules)
- Drop the file path headers, YAML frontmatter, session ids, "Related" link
  lists, index lists, and anything that only narrates how a session went.
- Do not add anything.
- Print ONLY the markdown, starting with the heading.
EOF
  if [ -n "$6" ]; then
    echo
    echo "Your previous attempt was $6 bytes, which is too long. It must be at most $3 bytes."
  fi
  if [ -n "$7" ]; then
    echo
    echo "Your previous attempt dropped the following, each of which must appear verbatim in the rewrite:"
    printf '%s\n' "$7" | sed 's/^/- /'
  fi
  echo
  echo '--- SECTION ---'
  cat "$1"
}

# Run the model on a chunk, up to twice, and validate the result.
#   $1 chunk file  $2 result file  $3 target bytes  $4 floor percent
#   $5 heading the first line must start with  $6 kind (section|import)
#   $7 identifier source (the text whose identifiers must survive)
#   $8 agent name for imports  $9 date for imports
# Prints the reason on stderr and returns 1 when the rewrite is refused.
compact_rewrite() {
  cr_chunk="$1" cr_out="$2" cr_target="$3" cr_floor="$4" cr_head="$5"
  cr_kind="$6" cr_ids="$7" cr_from="$8" cr_date="$9"
  cr_in=$(file_bytes "$cr_chunk")
  cr_prompt="$PRIVATE_TMP/compact-prompt"
  cr_prev=""
  cr_dropped=""
  cr_attempt=0
  while [ "$cr_attempt" -lt 2 ]; do
    cr_attempt=$((cr_attempt + 1))
    if [ "$cr_kind" = import ]; then
      compact_import_prompt "$cr_chunk" "$cr_in" "$cr_target" "$cr_from" "$cr_date" "$cr_prev" "$cr_dropped" >"$cr_prompt"
    else
      compact_section_prompt "$cr_chunk" "$cr_in" "$cr_target" "$cr_prev" "$cr_dropped" >"$cr_prompt"
    fi
    if ! invoke_synthesizer "$COMPACT_KIND" "$cr_prompt" "$cr_out"; then
      echo "the synthesizer failed" >&2
      return 1
    fi
    strip_synth_preamble "$cr_out"
    [ -s "$cr_out" ] || {
      echo "the synthesizer returned nothing" >&2
      return 1
    }
    case "$(head -1 "$cr_out")" in
      "$cr_head"*) ;;
      *)
        echo "the rewrite does not start with the heading" >&2
        return 1
        ;;
    esac
    cr_bytes=$(file_bytes "$cr_out")
    if [ $((cr_bytes * 100)) -lt $((cr_in * cr_floor)) ]; then
      echo "the rewrite is $cr_bytes bytes from $cr_in, below the ${cr_floor}% floor (a refusal, not a rewrite)" >&2
      return 1
    fi
    cr_missing=$(missing_identifiers "$cr_ids" "$cr_out")
    if [ -n "$cr_missing" ]; then
      # One more attempt, told exactly what it lost; a second drop is final.
      if [ "$cr_attempt" -lt 2 ]; then
        cr_dropped="$cr_missing"
        continue
      fi
      echo "the rewrite dropped: $(printf '%s' "$cr_missing" | tr '\n' ' ')" >&2
      return 1
    fi
    if [ "$cr_bytes" -ge "$cr_in" ]; then
      echo "the rewrite is $cr_bytes bytes, no smaller than the original" >&2
      return 1
    fi
    if [ $((cr_bytes * 100)) -le $((cr_target * COMPACT_OVERSHOOT_PERCENT)) ]; then
      return 0
    fi
    cr_prev="$cr_bytes"
  done
  if [ "$cr_bytes" -lt "$cr_in" ]; then
    echo "${C_DIM}(accepted $cr_bytes bytes against a $cr_target-byte target after two attempts)${C_OFF}"
    return 0
  fi
  echo "the rewrite is $cr_bytes bytes, no smaller than the original" >&2
  return 1
}

# Move one agent's store files into a dated tarball under the state dir and
# remove them, but only once the tarball lists every file it was given.
archive_stores() {
  as_from="$1"
  as_list="$PRIVATE_TMP/archive-list-$as_from"
  sources_for "$as_from" >"$as_list"
  as_count=$(grep -c . "$as_list" || true)
  [ "$as_count" -gt 0 ] || return 0
  mkdir -p "$STATE_DIR/archive"
  as_tar="$STATE_DIR/archive/stores-$as_from-$(date +%Y%m%d-%H%M%S).tar"
  : >"$as_tar"
  as_first=1
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if [ "$as_first" -eq 1 ]; then
      tar cf "$as_tar" -C / "${f#/}" || return 1
      as_first=0
    else
      tar rf "$as_tar" -C / "${f#/}" || return 1
    fi
  done <"$as_list"
  as_in_tar=$(tar tf "$as_tar" | grep -c . || true)
  if [ "$as_in_tar" -ne "$as_count" ]; then
    echo "${C_ERR}agent:${C_OFF} archive lists $as_in_tar of $as_count store file(s); leaving the stores of $as_from in place" >&2
    return 1
  fi
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    rm -f "$f"
  done <"$as_list"
  if command -v gzip >/dev/null 2>&1 && gzip -f "$as_tar"; then
    as_tar="$as_tar.gz"
  fi
  echo "$as_from: ${C_DIM}archived $as_count store file(s) to ${C_PATH}$as_tar${C_OFF}"
}

cmd_compact() {
  SYNTHESIZER_REQUEST="${AGENT_SYNC_SYNTHESIZER:-auto}"
  SYNTHESIZER_FROM_CLI=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --budget | --synthesizer | --only | --skip)
        opt="$1"
        if [ "$#" -lt 2 ]; then
          echo "${C_ERR}agent:${C_OFF} $opt requires a value" >&2
          return 2
        fi
        case "$opt" in
          --budget) COMPACT_BUDGET="$2" ;;
          --synthesizer)
            SYNTHESIZER_REQUEST="$2"
            SYNTHESIZER_FROM_CLI=1
            ;;
          --only) TARGET_ONLY="$2" ;;
          --skip) TARGET_SKIP="$2" ;;
        esac
        shift 2
        ;;
      --budget=*) COMPACT_BUDGET=${1#*=}; shift ;;
      --synthesizer=*)
        SYNTHESIZER_REQUEST=${1#*=}
        SYNTHESIZER_FROM_CLI=1
        shift
        ;;
      --only=*) TARGET_ONLY=${1#*=}; shift ;;
      --skip=*) TARGET_SKIP=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --force) COMPACT_FORCE=1; shift ;;
      --keep-all) COMPACT_MODE=strict; shift ;;
      *)
        echo "${C_ERR}agent:${C_OFF} unknown compact option: $1" >&2
        return 2
        ;;
    esac
  done
  validate_synthesizer_request || return 2
  require_src
  budget=$(compact_budget) || return 2
  if [ "$SYNTHESIZER_REQUEST" = deterministic ]; then
    echo "${C_ERR}agent:${C_OFF} compact needs a model synthesizer (claude, codex or a custom command); the deterministic merge cannot summarize" >&2
    return 2
  fi
  require_selected_synthesizer
  case "$SYNTHESIZER_REQUEST" in
    auto)
      COMPACT_KIND=""
      for kind in claude codex; do
        command -v "$kind" >/dev/null 2>&1 || continue
        COMPACT_KIND="$kind"
        break
      done
      if [ -z "$COMPACT_KIND" ]; then
        echo "${C_ERR}agent:${C_OFF} no synthesizer available: install claude or codex, or set AGENT_SYNC_SYNTHESIZER to a command" >&2
        return 2
      fi
      ;;
    claude | codex) COMPACT_KIND="$SYNTHESIZER_REQUEST" ;;
    *) COMPACT_KIND=custom ;;
  esac
  for name in claude codex cursor continue windsurf goose; do
    validate_import_section "$name" || return 1
  done
  total=$(file_bytes "$SRC")
  if [ "$total" -le "$budget" ] && [ "$COMPACT_FORCE" -eq 0 ]; then
    echo "compact: ${C_OK}$total of $budget bytes, within budget; nothing to do${C_OFF} ${C_DIM}(--force compacts anyway)${C_OFF}"
    return 0
  fi
  ensure_private_tmp
  cdir="$PRIVATE_TMP/compact"
  rm -rf "$cdir"
  mkdir -p "$cdir"
  compact_split "$cdir"
  goal=$((budget * COMPACT_HEADROOM_PERCENT / 100))
  [ "$total" -gt "$goal" ] || goal=$((total * 75 / 100))
  # What can shrink: agent imports (promoted) and sections worth a call.
  compressible=0
  while IFS='|' read -r idx kind; do
    chunk="$cdir/chunk-$(printf '%04d' "$idx")"
    bytes=$(file_bytes "$chunk")
    case "$kind" in
      import:pack:*) ;;
      import:*) compressible=$((compressible + bytes)) ;;
      section) [ "$bytes" -ge "$COMPACT_MIN_SECTION_BYTES" ] && compressible=$((compressible + bytes)) ;;
    esac
  done <"$cdir/manifest"
  if [ "$compressible" -eq 0 ]; then
    echo "${C_ERR}agent:${C_OFF} nothing to compact: no agent imports and no section of $COMPACT_MIN_SECTION_BYTES bytes or more" >&2
    return 1
  fi
  need=$((total - goal))
  ratio=$(((compressible - need) * 100 / compressible))
  [ "$ratio" -ge "$COMPACT_MIN_RATIO_PERCENT" ] || ratio="$COMPACT_MIN_RATIO_PERCENT"
  [ "$ratio" -lt 100 ] || ratio=99
  echo "compact: ${C_BOLD}$total bytes${C_OFF}, budget $budget, goal $goal; rewriting compressible sections to ${ratio}% via ${C_PLAN}$COMPACT_KIND${C_OFF} ${C_DIM}(mode: $COMPACT_MODE)${C_OFF}"
  today=$(date +%Y-%m-%d)
  promoted=""
  refused=0
  while IFS='|' read -r idx kind; do
    chunk="$cdir/chunk-$(printf '%04d' "$idx")"
    bytes=$(file_bytes "$chunk")
    out="$chunk.new"
    case "$kind" in
      import:pack:*) ;;
      import:*)
        from=${kind#import:}
        inner="$chunk.inner"
        # The model sees the import without its markers; the identifier
        # check ignores the path headers and frontmatter it is told to drop.
        sed '1d;$d' "$chunk" >"$inner"
        ids="$chunk.ids"
        identifier_source "$inner" >"$ids"
        target=$((bytes * ratio / 100))
        if [ "$DRY_RUN" -eq 1 ]; then
          echo "${C_PLAN}dry-run:${C_OFF} would promote import:$from ($bytes bytes) to about $target and archive its stores"
          continue
        fi
        printf 'import:%s: %s -> ' "$from" "$bytes"
        if reason=$(compact_rewrite "$inner" "$out" "$target" "$COMPACT_IMPORT_FLOOR_PERCENT" "## Promoted from $from" import "$ids" "$from" "$today" 2>&1 >/dev/null); then
          echo "${C_OK}$(file_bytes "$out") bytes${C_OFF} ${C_DIM}(promoted)${C_OFF}"
          promoted="$promoted $from"
        else
          echo "${C_WARN}kept${C_OFF} ${C_DIM}($reason)${C_OFF}"
          rm -f "$out"
          refused=$((refused + 1))
        fi
        ;;
      section)
        [ "$bytes" -ge "$COMPACT_MIN_SECTION_BYTES" ] || continue
        heading=$(head -1 "$chunk")
        target=$((bytes * ratio / 100))
        if [ "$DRY_RUN" -eq 1 ]; then
          echo "${C_PLAN}dry-run:${C_OFF} would rewrite \"$heading\" ($bytes bytes) to about $target"
          continue
        fi
        printf '%s: %s -> ' "$heading" "$bytes"
        if reason=$(compact_rewrite "$chunk" "$out" "$target" "$COMPACT_SECTION_FLOOR_PERCENT" "$heading" section "$chunk" "" "" 2>&1 >/dev/null); then
          echo "${C_OK}$(file_bytes "$out") bytes${C_OFF}"
        else
          echo "${C_WARN}kept${C_OFF} ${C_DIM}($reason)${C_OFF}"
          rm -f "$out"
          refused=$((refused + 1))
        fi
        ;;
    esac
  done <"$cdir/manifest"
  if [ "$DRY_RUN" -eq 1 ]; then
    echo "${C_PLAN}dry-run: no model was called and nothing was written${C_OFF}"
    return 0
  fi
  CANON_TMP=$(mktemp "$(dirname "$SRC")/.agent-sync.XXXXXXXX") || {
    echo "${C_ERR}agent:${C_OFF} could not create a temporary file beside $SRC" >&2
    exit 1
  }
  while IFS='|' read -r idx kind; do
    chunk="$cdir/chunk-$(printf '%04d' "$idx")"
    if [ -f "$chunk.new" ]; then
      case "$kind" in
        import:*)
          # A promoted import becomes a plain section: blank line, notes,
          # blank line, no markers, so the next sync has nothing to refresh.
          echo
          cat "$chunk.new"
          echo
          ;;
        *) cat "$chunk.new" ;;
      esac
    else
      cat "$chunk"
    fi
  done <"$cdir/manifest" >"$CANON_TMP"
  cp "$SRC" "$SRC.bak"
  mv "$CANON_TMP" "$SRC"
  CANON_TMP=""
  for from in $promoted; do
    archive_stores "$from" || echo "${C_WARN}the stores of $from were not archived; the next sync will re-import them${C_OFF}"
  done
  distribute
  final=$(file_bytes "$SRC")
  echo "compact: ${C_BOLD}$total -> $final bytes${C_OFF} ${C_DIM}(previous file at $SRC.bak)${C_OFF}"
  [ "$refused" -eq 0 ] || echo "${C_WARN}$refused section(s) kept as they were; see the reasons above${C_OFF}"
  if [ "$final" -gt "$budget" ]; then
    echo "${C_WARN}still $((final - budget)) bytes over the $budget-byte budget; run agent compact again${C_OFF}"
    return 1
  fi
}

distribute() {
  while IFS='|' read -r name dir dest mode; do
    if ! target_selected "$name"; then
      echo "$name: ${C_DIM}skipped (filtered)${C_OFF}"
      continue
    fi
    if [ ! -d "$dir" ]; then
      echo "$name: ${C_DIM}skipped (not installed)${C_OFF}"
      continue
    fi
    if [ "$DRY_RUN" -eq 1 ]; then
      echo "$name: ${C_PLAN}would sync${C_OFF} ${C_DIM}->${C_OFF} ${C_PATH}$dest${C_OFF}"
      continue
    fi
    mkdir -p "$(dirname "$dest")"
    TARGET_TMP=$(mktemp "$(dirname "$dest")/.agent-sync-target.XXXXXXXX") || {
      echo "${C_ERR}agent:${C_OFF} could not create a temporary file beside $dest" >&2
      exit 1
    }
    case "$mode" in
      copy) cp "$SRC" "$TARGET_TMP" ;;
      cursor) cursor_render >"$TARGET_TMP" ;;
    esac
    # Adopt safety: before the first overwrite of a differing pre-existing
    # file, keep the original beside it. agent revert restores it.
    if [ -f "$dest" ] && [ ! -f "$dest.orig" ] &&
      [ "$(sum "$dest")" != "$(sum "$TARGET_TMP")" ]; then
      cp "$dest" "$dest.orig"
      echo "$name: ${C_WARN}pre-existing file preserved at${C_OFF} ${C_PATH}$dest.orig${C_OFF}"
    fi
    mv "$TARGET_TMP" "$dest"
    TARGET_TMP=""
    echo "$name: ${C_OK}synced${C_OFF} ${C_DIM}->${C_OFF} ${C_PATH}$dest${C_OFF}"
  done <<EOF
$(targets)
EOF
}

# Fold one installed memory pack into the synthesized file.
import_pack() {
  pname="$1"
  ensure_private_tmp
  content="$PRIVATE_TMP/pack-content"
  {
    echo "## Memory pack: $pname"
    echo
    echo "Installed via agent pack; refresh with: agent pack update"
  } >"$content"
  found=0
  for f in "$PACKS_DIR/$pname"/*.md; do
    [ -f "$f" ] || continue
    {
      echo
      echo "### $(basename "$f")"
      echo
      neutralize_markers "$f"
      printf '\n'
    } >>"$content"
    found=$((found + 1))
  done
  import_into_canon "pack:$pname" "$content" "$found"
}

each_pack_name() {
  [ -f "$PACKS_LOCK" ] || return 0
  while IFS="$TAB" read -r pname _src _ref _sha; do
    [ -n "$pname" ] && echo "$pname"
  done <"$PACKS_LOCK"
}

cmd_sync() {
  parse_synthesizer_args "$@"
  sync_after_options
}

sync_after_options() {
  require_src
  require_selected_synthesizer
  for name in claude codex cursor continue windsurf goose; do
    validate_import_section "$name"
  done
  for pname in $(each_pack_name); do
    validate_import_section "pack:$pname"
  done
  for name in claude codex cursor continue windsurf goose; do
    import_agent "$name"
    n="$IMPORTED_COUNT"
    [ "$n" -gt 0 ] && echo "$name: ${C_DIM}folded $n memory file(s) in${C_OFF}"
  done
  for pname in $(each_pack_name); do
    import_pack "$pname"
  done
  synthesize
  distribute
  budget_report || true
}

cmd_status() {
  require_src
  fails=0
  src_sum=$(sum "$SRC")
  while IFS='|' read -r name dir dest mode; do
    target_selected "$name" || continue
    if [ ! -d "$dir" ]; then
      echo "$name: ${C_DIM}not installed${C_OFF}"
      continue
    fi
    if [ ! -f "$dest" ]; then
      echo "$name: ${C_BOLD}${C_WARN}STALE${C_OFF} ${C_DIM}(missing $dest)${C_OFF}"
      fails=$((fails + 1))
      continue
    fi
    case "$mode" in
      copy) want="$src_sum" ;;
      cursor)
        ensure_private_tmp
        tmp="$PRIVATE_TMP/cursor-expected"
        cursor_render >"$tmp"
        want=$(sum "$tmp")
        ;;
    esac
    if [ "$(sum "$dest")" = "$want" ]; then
      echo "$name: ${C_OK}synced${C_OFF}"
    else
      echo "$name: ${C_BOLD}${C_WARN}STALE${C_OFF}"
      fails=$((fails + 1))
    fi
  done <<EOF
$(targets)
EOF
  over=0
  budget_report || over=1
  [ "$fails" -eq 0 ] || {
    echo "${C_WARN}$fails target(s) stale; run: agent sync${C_OFF}"
    exit 1
  }
  [ "$over" -eq 0 ] || exit 1
}

cmd_targets() {
  while IFS='|' read -r name dir dest mode; do
    if [ -d "$dir" ]; then
      echo "$name: ${C_OK}installed${C_OFF} ${C_DIM}(${C_OFF}${C_PATH}$dest${C_OFF}${C_DIM})${C_OFF}"
    else
      echo "$name: ${C_DIM}not installed (would be $dest)${C_OFF}"
    fi
  done <<EOF
$(targets)
EOF
}

cmd_migrate() {
  from="${1:-}"
  if [ -z "$from" ]; then
    echo "${C_WARN}usage:${C_OFF} agent migrate <claude|codex|cursor|continue|windsurf|goose>" >&2
    exit 2
  fi
  require_src
  validate_import_section "$from"
  import_agent "$from"
  n="$IMPORTED_COUNT"
  if [ "$n" -eq 0 ]; then
    echo "${C_ERR}agent:${C_OFF} no readable memory stores found for $from" >&2
    distribute
    exit 1
  fi
  echo "$from: ${C_DIM}folded $n memory file(s) into${C_OFF} ${C_PATH}$SRC${C_OFF}"
  distribute
}

cmd_gather() {
  dest="${1:-./agent-memories}"
  mkdir -p "$dest"
  # The manifest is written atomically because `apply` treats it as authority.
  manifest="$dest/.agent-manifest"
  MANIFEST_TMP=$(mktemp "$dest/.agent-manifest.XXXXXXXX") || {
    echo "${C_ERR}agent:${C_OFF} could not create a temporary manifest in $dest" >&2
    exit 1
  }
  gathered=0
  ensure_private_tmp
  list="$PRIVATE_TMP/gather-list"
  for name in claude codex cursor continue windsurf goose; do
    sources_for "$name" >"$list"
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      staged="${name}__$(basename "$(dirname "$f")")__$(basename "$f")"
      if [ -e "$dest/$staged" ]; then
        n=2
        while [ -e "$dest/${n}__$staged" ]; do n=$((n + 1)); done
        staged="${n}__$staged"
      fi
      cp "$f" "$dest/$staged"
      printf '%s\t%s\n' "$staged" "$f" >>"$MANIFEST_TMP"
      gathered=$((gathered + 1))
    done <"$list"
  done
  mv "$MANIFEST_TMP" "$manifest"
  MANIFEST_TMP=""
  echo "gathered ${C_NUM}$gathered memory file(s)${C_OFF} into ${C_PATH}$dest${C_OFF}"
  echo "${C_DIM}edit the staged files, then push edits everywhere with: agent apply $dest${C_OFF}"
  echo "${C_WARN}note: gathered files can contain private context; do not commit them${C_OFF}"
}

is_memory_store_path() {
  path="$1"
  [ "$path" = "$SRC" ] && return 1
  case "$path" in
    */../* | */./* | */.. | */.) return 1 ;;
    "$AGENT_HOME/.cursor/rules/best-practices.mdc" | \
      "$AGENT_HOME/.cursor/rules/best-practices.md" | \
      "$AGENT_HOME/.continue/rules/best-practices.md" | \
      "$AGENT_HOME/.codeium/windsurf/memories/global_rules.md") return 1 ;;
    "$AGENT_HOME"/.claude/projects/*/memory/*.md | \
      "$AGENT_HOME"/.codex/memories/*.md | \
      "$AGENT_HOME"/.cursor/rules/*.mdc | \
      "$AGENT_HOME"/.cursor/rules/*.md | \
      "$AGENT_HOME"/.continue/rules/*.md | \
      "$AGENT_HOME"/.codeium/windsurf/memories/*.md | \
      "$AGENT_HOME"/.config/goose/memory/*.md | \
      "$AGENT_HOME"/.config/goose/memory/*.txt) return 0 ;;
    *) return 1 ;;
  esac
}

validate_manifest() {
  dir="$1"
  manifest="$2"
  line=0
  while IFS="$TAB" read -r staged orig; do
    line=$((line + 1))
    [ -n "$staged" ] || [ -n "$orig" ] || continue
    if [ -z "$staged" ] || [ -z "$orig" ] ||
      [ "$staged" != "$(basename "$staged")" ] ||
      ! is_memory_store_path "$orig"; then
      echo "${C_ERR}agent:${C_OFF} unsafe manifest entry at $manifest:$line" >&2
      return 1
    fi
    if [ -L "$dir/$staged" ]; then
      echo "${C_ERR}agent:${C_OFF} staged file is a symbolic link at $manifest:$line" >&2
      return 1
    fi
  done <"$manifest"
}

cmd_apply() {
  dir="./agent-memories"
  found_dir=0
  SYNTHESIZER_REQUEST="${AGENT_SYNC_SYNTHESIZER:-auto}"
  SYNTHESIZER_FROM_CLI=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --synthesizer | --only | --skip)
        opt="$1"
        if [ "$#" -lt 2 ]; then
          echo "${C_ERR}agent:${C_OFF} $opt requires a value" >&2
          return 2
        fi
        case "$opt" in
          --synthesizer)
            SYNTHESIZER_REQUEST="$2"
            SYNTHESIZER_FROM_CLI=1
            ;;
          --only) TARGET_ONLY="$2" ;;
          --skip) TARGET_SKIP="$2" ;;
        esac
        shift 2
        ;;
      --synthesizer=*)
        SYNTHESIZER_REQUEST=${1#*=}
        SYNTHESIZER_FROM_CLI=1
        shift
        ;;
      --only=*) TARGET_ONLY=${1#*=}; shift ;;
      --skip=*) TARGET_SKIP=${1#*=}; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      --*)
        echo "${C_ERR}agent:${C_OFF} unknown apply option: $1" >&2
        return 2
        ;;
      *)
        if [ "$found_dir" -eq 0 ]; then
          dir="$1"
          found_dir=1
        else
          echo "${C_ERR}agent:${C_OFF} unexpected apply argument: $1" >&2
          return 2
        fi
        shift
        ;;
    esac
  done
  validate_synthesizer_request
  manifest="$dir/.agent-manifest"
  if [ ! -f "$manifest" ]; then
    echo "${C_ERR}agent:${C_OFF} $dir is not a gather directory (missing .agent-manifest)" >&2
    echo "stage stores first with: agent gather $dir" >&2
    exit 1
  fi
  if [ -L "$manifest" ]; then
    echo "${C_ERR}agent:${C_OFF} refusing symbolic-link manifest: $manifest" >&2
    exit 1
  fi
  require_src
  require_selected_synthesizer
  validate_manifest "$dir" "$manifest"
  updated=0
  while IFS="$TAB" read -r staged orig; do
    if [ -z "$staged" ] || [ -z "$orig" ]; then
      continue
    fi
    s="$dir/$staged"
    [ -f "$s" ] || continue
    if [ ! -f "$orig" ] || [ "$(sum "$s")" != "$(sum "$orig")" ]; then
      if [ "$DRY_RUN" -eq 1 ]; then
        echo "${C_PLAN}dry-run: would update store:${C_OFF} ${C_PATH}$orig${C_OFF}"
        updated=$((updated + 1))
        continue
      fi
      mkdir -p "$(dirname "$orig")"
      APPLY_TMP=$(mktemp "$(dirname "$orig")/.agent-sync-apply.XXXXXXXX") || {
        echo "${C_ERR}agent:${C_OFF} could not create a temporary file beside $orig" >&2
        exit 1
      }
      cp "$s" "$APPLY_TMP"
      mv "$APPLY_TMP" "$orig"
      APPLY_TMP=""
      echo "updated store: ${C_PATH}$orig${C_OFF}"
      updated=$((updated + 1))
    fi
  done <"$manifest"
  echo "${C_NUM}$updated store file(s)${C_OFF} updated from ${C_PATH}$dir${C_OFF}"
  sync_after_options
}

# Paint a unified diff. Only ever reached with colour on, so the plain path
# stays a bare `diff -u` and its bytes are untouched for CI and pipes.
color_diff() {
  while IFS= read -r cd_line; do
    case "$cd_line" in
      +++* | ---*) printf '%s%s%s\n' "$C_BOLD" "$cd_line" "$C_OFF" ;;
      @@*) printf '%s%s%s\n' "$C_PATH" "$cd_line" "$C_OFF" ;;
      +*) printf '%s%s%s\n' "$C_OK" "$cd_line" "$C_OFF" ;;
      -*) printf '%s%s%s\n' "$C_ERR" "$cd_line" "$C_OFF" ;;
      \\*) printf '%s%s%s\n' "$C_DIM" "$cd_line" "$C_OFF" ;;
      *) printf '%s\n' "$cd_line" ;;
    esac
  done
}

# Show exactly what is stale, as unified diffs. Exits 1 when anything is
# stale, so it doubles as a CI drift gate.
cmd_diff() {
  require_src
  stale=0
  ensure_private_tmp
  while IFS='|' read -r name dir dest mode; do
    target_selected "$name" || continue
    [ -d "$dir" ] || continue
    expected="$SRC"
    if [ "$mode" = "cursor" ]; then
      cursor_render >"$PRIVATE_TMP/diff-expected"
      expected="$PRIVATE_TMP/diff-expected"
    fi
    if [ ! -f "$dest" ]; then
      echo "${C_BOLD}=== $name: $dest is missing${C_OFF}"
      stale=$((stale + 1))
      continue
    fi
    if ! cmp -s "$dest" "$expected"; then
      echo "${C_BOLD}=== $name: $dest${C_OFF}"
      if color_on; then
        diff -u "$dest" "$expected" | color_diff || true
      else
        diff -u "$dest" "$expected" || true
      fi
      stale=$((stale + 1))
    fi
  done <<EOF
$(targets)
EOF
  if [ "$stale" -eq 0 ]; then
    echo "${C_OK}all targets in sync${C_OFF}"
  else
    echo "${C_WARN}$stale stale target(s); run: agent sync${C_OFF}"
    exit 1
  fi
}

# Undo: restore every target from its .orig adoption backup and the
# synthesized file from its last synthesis backup.
cmd_revert() {
  restored=0
  while IFS='|' read -r name dir dest mode; do
    [ -f "$dest.orig" ] || continue
    mv "$dest.orig" "$dest"
    echo "$name: ${C_OK}restored${C_OFF} ${C_PATH}$dest${C_OFF} ${C_DIM}from its .orig backup${C_OFF}"
    restored=$((restored + 1))
  done <<EOF
$(targets)
EOF
  if [ -f "$SRC.bak" ]; then
    cp "$SRC.bak" "$SRC"
    echo "${C_OK}synthesized file restored${C_OFF} ${C_DIM}from $SRC.bak${C_OFF}"
    restored=$((restored + 1))
  fi
  [ "$restored" -gt 0 ] || echo "${C_DIM}nothing to revert (no .orig or .bak files found)${C_OFF}"
}

# Diagnose the setup: file present, markers well-formed, targets detected,
# synthesis available, staleness.
cmd_doctor() {
  problems=0
  # Pre-create the private tmp: the status probe below runs in a subshell,
  # which resets the EXIT trap, so it must not be the one to create it.
  ensure_private_tmp
  echo "${C_BOLD}agent v$VERSION${C_OFF}"
  echo "synthesized file: ${C_PATH}$SRC${C_OFF}"
  if [ -f "$SRC" ]; then
    echo "${C_OK}ok:${C_OFF} synthesized file exists ($(wc -l <"$SRC" | tr -d ' ') lines)"
    for name in claude codex cursor continue windsurf goose; do
      if ! validate_import_section "$name" 2>/dev/null; then
        echo "${C_ERR}PROBLEM:${C_OFF} malformed import markers for $name in $SRC"
        problems=$((problems + 1))
      fi
    done
  else
    echo "${C_ERR}PROBLEM:${C_OFF} synthesized file is missing; create it, then run agent sync"
    problems=$((problems + 1))
  fi
  installed=0
  while IFS='|' read -r name dir dest mode; do
    [ -d "$dir" ] && installed=$((installed + 1))
  done <<EOF
$(targets)
EOF
  if [ "$installed" -gt 0 ]; then
    echo "${C_OK}ok:${C_OFF} $installed sync target(s) detected (agent targets lists them)"
  else
    echo "${C_ERR}PROBLEM:${C_OFF} no agents detected under $AGENT_HOME"
    problems=$((problems + 1))
  fi
  for cli in claude codex; do
    if command -v "$cli" >/dev/null 2>&1; then
      echo "${C_OK}ok:${C_OFF} $cli CLI available for semantic synthesis"
    else
      echo "${C_DIM}note: $cli CLI not installed (auto synthesis skips it)${C_OFF}"
    fi
  done
  [ -f "$SRC.bak" ] && echo "${C_DIM}note: last synthesis backup at $SRC.bak${C_OFF}"
  if [ -f "$SRC" ] && ! budget_report >/dev/null 2>&1; then
    echo "${C_ERR}PROBLEM:${C_OFF} synthesized file is $(file_bytes "$SRC") bytes, over the $(compact_budget)-byte budget (agent compact fixes)"
    problems=$((problems + 1))
  fi
  if [ -f "$SRC" ] && ! (cmd_status) >/dev/null 2>&1; then
    echo "${C_ERR}PROBLEM:${C_OFF} targets are stale (agent diff shows details; agent sync fixes)"
    problems=$((problems + 1))
  fi
  if [ "$problems" -eq 0 ]; then
    echo "${C_OK}doctor: no problems found${C_OFF}"
  else
    echo "${C_ERR}doctor: $problems problem(s) found${C_OFF}"
    exit 1
  fi
}

# Project scope: make one repo-root AGENTS.md readable by every agent.
# AGENTS.md is read natively by Codex, Cursor, Copilot, Zed, Amp, OpenCode,
# Junie, Goose, Jules and others; Claude Code needs an @AGENTS.md import
# stub; Gemini CLI needs context.fileName in .gemini/settings.json.
cmd_link() {
  dir="."
  do_import=0
  for a in "$@"; do
    case "$a" in
      --import) do_import=1 ;;
      -*)
        echo "${C_ERR}agent:${C_OFF} unknown link option: $a" >&2
        exit 2
        ;;
      *) dir="$a" ;;
    esac
  done
  if [ ! -d "$dir" ]; then
    echo "${C_ERR}agent:${C_OFF} not a directory: $dir" >&2
    exit 2
  fi
  agents_md="$dir/AGENTS.md"
  claude_md="$dir/CLAUDE.md"
  stub='@AGENTS.md'
  if [ ! -f "$agents_md" ]; then
    if [ -f "$claude_md" ]; then
      cp "$claude_md" "$agents_md"
      echo "${C_DIM}link:${C_OFF} seeded AGENTS.md from the existing CLAUDE.md"
    else
      printf '# Project instructions\n\nShared instructions for every AI coding agent working in this repository.\n' >"$agents_md"
      echo "${C_DIM}link:${C_OFF} created a starter AGENTS.md"
    fi
  fi
  if [ ! -f "$claude_md" ]; then
    printf '%s\n' "$stub" >"$claude_md"
    echo "${C_DIM}link:${C_OFF} created CLAUDE.md stub importing AGENTS.md"
  elif [ "$(head -1 "$claude_md")" = "$stub" ]; then
    echo "${C_DIM}link:${C_OFF} CLAUDE.md already imports AGENTS.md"
  elif cmp -s "$claude_md" "$agents_md"; then
    printf '%s\n' "$stub" >"$claude_md"
    echo "${C_DIM}link:${C_OFF} CLAUDE.md now imports AGENTS.md (content was identical)"
  else
    echo "${C_DIM}link:${C_OFF} CLAUDE.md has its own content; left untouched (put $stub on its first line to bridge it)"
  fi
  gemini_settings="$dir/.gemini/settings.json"
  if [ -f "$gemini_settings" ]; then
    if grep -q 'AGENTS\.md' "$gemini_settings"; then
      echo "${C_DIM}link:${C_OFF} Gemini CLI already configured for AGENTS.md"
    else
      echo "${C_DIM}link:${C_OFF} ${C_WARN}$gemini_settings exists; add {\"context\":{\"fileName\":[\"AGENTS.md\",\"GEMINI.md\"]}} yourself (not overwriting your settings)${C_OFF}"
    fi
  else
    mkdir -p "$dir/.gemini"
    printf '{\n  "context": { "fileName": ["AGENTS.md", "GEMINI.md"] }\n}\n' >"$gemini_settings"
    echo "${C_DIM}link:${C_OFF} created .gemini/settings.json so Gemini CLI reads AGENTS.md"
  fi
  for shadow in .rules .cursorrules .windsurfrules .clinerules .github/copilot-instructions.md AGENT.md; do
    if [ -e "$dir/$shadow" ]; then
      echo "${C_DIM}link:${C_OFF} ${C_WARN}note: $shadow shadows AGENTS.md in Zed (first-match order)${C_OFF}"
    fi
  done
  # --import: fold the repo's native per-tool configs into AGENTS.md under a
  # managed marker, verbatim (frontmatter preserved), refreshed on re-run.
  if [ "$do_import" -eq 1 ]; then
    ensure_private_tmp
    content="$PRIVATE_TMP/link-import"
    {
      echo "## Imported project agent configs"
      echo
      echo "Folded verbatim by agent link --import; re-run it to refresh."
    } >"$content"
    found=0
    for f in "$dir"/.cursor/rules/*.mdc "$dir"/.cursorrules "$dir"/.windsurfrules \
      "$dir"/.clinerules "$dir"/.clinerules/*.md "$dir"/.github/copilot-instructions.md \
      "$dir"/.roo/rules/*.md "$dir"/.goosehints; do
      [ -f "$f" ] || continue
      {
        echo
        echo "### ${f#"$dir"/}"
        echo
        neutralize_markers "$f"
        printf '\n'
      } >>"$content"
      found=$((found + 1))
    done
    if [ "$found" -gt 0 ]; then
      old_src="$SRC"
      SRC="$agents_md"
      if validate_import_section "project"; then
        import_into_canon "project" "$content" "$found"
        SRC="$old_src"
        echo "${C_DIM}link:${C_OFF} imported ${C_NUM}$found native config file(s)${C_OFF} into AGENTS.md"
      else
        SRC="$old_src"
        exit 1
      fi
    else
      echo "${C_DIM}link:${C_OFF} no native agent configs found to import"
    fi
  fi
  echo "${C_DIM}link:${C_OFF} ${C_OK}done; AGENTS.md is the single project instructions file${C_OFF}"
}

pack_lock_remove() {
  pname="$1"
  [ -f "$PACKS_LOCK" ] || return 0
  ensure_private_tmp
  awk -F "$TAB" -v n="$pname" '$1 != n' "$PACKS_LOCK" >"$PRIVATE_TMP/lock" &&
    cp "$PRIVATE_TMP/lock" "$PACKS_LOCK"
}

# Shareable memory packs: markdown pulled from a GitHub repo at a pinned
# commit, recorded in a lockfile, folded into the synthesized file on sync.
cmd_pack() {
  sub="${1:-list}"
  case "$sub" in
    add)
      spec="${2:-}"
      if [ -z "$spec" ]; then
        echo "${C_WARN}usage:${C_OFF} agent pack add OWNER/REPO[@REF][:SUBDIR]" >&2
        exit 2
      fi
      subdir=""
      case "$spec" in *:*)
        subdir=${spec#*:}
        spec=${spec%%:*}
        ;;
      esac
      ref="HEAD"
      case "$spec" in *@*)
        ref=${spec#*@}
        spec=${spec%%@*}
        ;;
      esac
      case "$spec" in
        */*) ;;
        *)
          echo "${C_ERR}agent:${C_OFF} pack source must be OWNER/REPO" >&2
          exit 2
          ;;
      esac
      # Owner is part of the name so otherowner/repo cannot shadow an
      # installed owner/repo pack; tr collapses path characters so the name
      # is always one safe path segment.
      pname=$(printf '%s' "$spec${subdir:+-$subdir}" | tr -c 'A-Za-z0-9._\n-' '-')
      require_safe_name "$pname"
      sha=$(curl -fsSL "https://api.github.com/repos/$spec/commits/$ref" |
        sed -n 's/^  "sha": *"\([0-9a-f]*\)".*/\1/p' | head -1)
      if [ -z "$sha" ]; then
        echo "${C_ERR}agent:${C_OFF} could not resolve $spec@$ref" >&2
        exit 1
      fi
      ensure_private_tmp
      curl -fsSL "https://codeload.github.com/$spec/tar.gz/$sha" -o "$PRIVATE_TMP/pack.tgz"
      mkdir -p "$PRIVATE_TMP/pack-x"
      tar -xzf "$PRIVATE_TMP/pack.tgz" -C "$PRIVATE_TMP/pack-x"
      archive_root=$(find "$PRIVATE_TMP/pack-x" -mindepth 1 -maxdepth 1 -type d | head -1)
      srcdir="$archive_root"
      [ -n "$subdir" ] && srcdir="$archive_root/$subdir"
      if [ ! -d "$srcdir" ]; then
        echo "${C_ERR}agent:${C_OFF} subdir not found in pack: $subdir" >&2
        exit 1
      fi
      root_phys=$(physical_path "$archive_root")
      src_phys=$(physical_path "$srcdir")
      case "$src_phys/" in
        "$root_phys/" | "$root_phys"/*) ;;
        *)
          echo "${C_ERR}agent:${C_OFF} pack subdir escapes the downloaded repository: $subdir" >&2
          exit 1
          ;;
      esac
      srcdir="$src_phys"
      # Stage first: existing pack content and its lock entry survive a
      # fetch that yields nothing. Symlinked tarball entries are never
      # followed (they can point at arbitrary local files).
      stage="$PRIVATE_TMP/pack-stage"
      rm -rf "$stage"
      mkdir -p "$stage"
      copied=0
      for f in "$srcdir"/*.md; do
        [ -f "$f" ] || continue
        [ -L "$f" ] && continue
        case "$(basename "$f")" in LICENSE* | CHANGELOG* | CONTRIBUTING* | CODE_OF_CONDUCT*) continue ;; esac
        cp "$f" "$stage/"
        copied=$((copied + 1))
      done
      if [ "$copied" -eq 0 ]; then
        echo "${C_ERR}agent:${C_OFF} no markdown files found in $spec${subdir:+:$subdir}; keeping any existing pack content" >&2
        exit 1
      fi
      mkdir -p "$PACKS_DIR"
      rm -rf "${PACKS_DIR:?}/$pname"
      mv "$stage" "$PACKS_DIR/$pname"
      mkdir -p "$STATE_DIR"
      touch "$PACKS_LOCK"
      pack_lock_remove "$pname"
      printf '%s\t%s\t%s\t%s\n' "$pname" "$spec${subdir:+:$subdir}" "$ref" "$sha" >>"$PACKS_LOCK"
      echo "pack $pname: ${C_NUM}$copied file(s)${C_OFF} pinned at $spec@$(printf '%.12s' "$sha")"
      echo "${C_DIM}run: agent sync (folds the pack into the synthesized file)${C_OFF}"
      ;;
    list)
      if [ -s "$PACKS_LOCK" ] 2>/dev/null; then
        while IFS="$TAB" read -r pname psrc pref psha; do
          [ -n "$pname" ] || continue
          echo "$pname: $psrc@$pref ${C_DIM}(pinned $(printf '%.12s' "$psha"))${C_OFF}"
        done <"$PACKS_LOCK"
      else
        echo "${C_DIM}no packs installed (agent pack add OWNER/REPO)${C_OFF}"
      fi
      ;;
    update)
      only="${2:-}"
      [ -f "$PACKS_LOCK" ] || {
        echo "${C_DIM}no packs installed${C_OFF}"
        exit 0
      }
      ensure_private_tmp
      cp "$PACKS_LOCK" "$PRIVATE_TMP/lock-snapshot"
      while IFS="$TAB" read -r pname psrc pref _sha; do
        [ -n "$pname" ] || continue
        [ -z "$only" ] || [ "$only" = "$pname" ] || continue
        base=${psrc%%:*}
        sub=""
        case "$psrc" in *:*) sub=${psrc#*:} ;; esac
        # The colour decision does not survive re-exec on its own: stdout may
        # be a pipe here while the caller forced colour on.
        "$0" "--color=$COLOR_MODE" pack add "$base@$pref${sub:+:$sub}"
      done <"$PRIVATE_TMP/lock-snapshot"
      ;;
    remove)
      pname="${2:-}"
      if [ -z "$pname" ]; then
        echo "${C_WARN}usage:${C_OFF} agent pack remove NAME" >&2
        exit 2
      fi
      require_safe_name "$pname"
      rm -rf "${PACKS_DIR:?}/$pname"
      pack_lock_remove "$pname"
      if [ -f "$SRC" ] && validate_import_section "pack:$pname"; then
        ensure_private_tmp
        : >"$PRIVATE_TMP/empty"
        import_into_canon "pack:$pname" "$PRIVATE_TMP/empty" 0
      fi
      echo "pack $pname ${C_OK}removed${C_OFF}${C_DIM}; run: agent sync${C_OFF}"
      ;;
    *)
      echo "${C_WARN}usage:${C_OFF} agent pack <add|list|update|remove>" >&2
      exit 2
      ;;
  esac
}

# ---------------------------------------------------------------------------
# MCP server sync. Registry entries are line-based spec files agent-sync can
# both write and read (no JSON parsing in sh); each tool then gets the server
# through its own CLI where one exists, or a dedicated owned config file.
# Every command grammar and file shape below was verified against the tool's
# official documentation.

json_escape() {
  printf '%s' "$1" | tr -d '\r' | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

# Load one spec file into MCP_TYPE/MCP_CMD/MCP_URL plus list files
# $PRIVATE_TMP/mcp-{args,envs,headers} (one value per line).
mcp_load_spec() {
  spec="$1"
  ensure_private_tmp
  MCP_TYPE="" MCP_CMD="" MCP_URL=""
  : >"$PRIVATE_TMP/mcp-args"
  : >"$PRIVATE_TMP/mcp-envs"
  : >"$PRIVATE_TMP/mcp-headers"
  while IFS= read -r line; do
    case "$line" in
      type=*) MCP_TYPE=${line#type=} ;;
      command=*) MCP_CMD=${line#command=} ;;
      url=*) MCP_URL=${line#url=} ;;
      arg=*) printf '%s\n' "${line#arg=}" >>"$PRIVATE_TMP/mcp-args" ;;
      env=*) printf '%s\n' "${line#env=}" >>"$PRIVATE_TMP/mcp-envs" ;;
      header=*) printf '%s\n' "${line#header=}" >>"$PRIVATE_TMP/mcp-headers" ;;
    esac
  done <"$spec"
}

# Render the loaded spec as a Claude-shaped JSON object (the de-facto
# standard shape; cursor/windsurf/kiro variants derive from it).
mcp_render_json() {
  style="$1" # claude | cursor | windsurf | kiro
  if [ "$MCP_TYPE" = "stdio" ]; then
    printf '{'
    case "$style" in
      claude | cursor) printf '"type": "stdio", ' ;;
    esac
    printf '"command": "%s"' "$(json_escape "$MCP_CMD")"
    if [ -s "$PRIVATE_TMP/mcp-args" ]; then
      printf ', "args": ['
      first=1
      while IFS= read -r a; do
        [ "$first" -eq 1 ] || printf ', '
        printf '"%s"' "$(json_escape "$a")"
        first=0
      done <"$PRIVATE_TMP/mcp-args"
      printf ']'
    fi
    if [ -s "$PRIVATE_TMP/mcp-envs" ]; then
      printf ', "env": {'
      first=1
      while IFS= read -r e; do
        [ "$first" -eq 1 ] || printf ', '
        printf '"%s": "%s"' "$(json_escape "${e%%=*}")" "$(json_escape "${e#*=}")"
        first=0
      done <"$PRIVATE_TMP/mcp-envs"
      printf '}'
    fi
    printf '}'
  else
    printf '{'
    case "$style" in
      claude) printf '"type": "http", "url": "%s"' "$(json_escape "$MCP_URL")" ;;
      windsurf) printf '"serverUrl": "%s"' "$(json_escape "$MCP_URL")" ;;
      *) printf '"url": "%s"' "$(json_escape "$MCP_URL")" ;;
    esac
    if [ -s "$PRIVATE_TMP/mcp-headers" ]; then
      printf ', "headers": {'
      first=1
      while IFS= read -r h; do
        [ "$first" -eq 1 ] || printf ', '
        printf '"%s": "%s"' "$(json_escape "${h%%:*}")" "$(json_escape "$(printf '%s' "${h#*:}" | sed 's/^ //')")"
        first=0
      done <"$PRIVATE_TMP/mcp-headers"
      printf '}'
    fi
    printf '}'
  fi
}

# Add or remove one loaded spec through a tool's supported CLI.
mcp_add_cli() {
  mca_tool="$1"
  mca_name="$2"
  case "$mca_tool" in
    claude)
      claude mcp add-json "$mca_name" "$(mcp_render_json claude)" --scope user >/dev/null
      ;;
    codex)
      if [ "$MCP_TYPE" = "stdio" ]; then
        set --
        while IFS= read -r e; do
          set -- "$@" --env "$e"
        done <"$PRIVATE_TMP/mcp-envs"
        set -- "$@" -- "$MCP_CMD"
        while IFS= read -r a; do
          set -- "$@" "$a"
        done <"$PRIVATE_TMP/mcp-args"
        codex mcp add "$mca_name" "$@" >/dev/null
      else
        if [ -s "$PRIVATE_TMP/mcp-headers" ]; then
          echo "codex: ${C_WARN}note: the codex CLI takes no custom headers; header(s) omitted for $mca_name${C_OFF}" >&2
        fi
        codex mcp add "$mca_name" --url "$MCP_URL" >/dev/null
      fi
      ;;
    gemini | qwen)
      if [ "$MCP_TYPE" = "stdio" ]; then
        set --
        while IFS= read -r e; do
          set -- "$@" -e "$e"
        done <"$PRIVATE_TMP/mcp-envs"
        set -- "$@" "$mca_name" "$MCP_CMD"
        while IFS= read -r a; do
          set -- "$@" "$a"
        done <"$PRIVATE_TMP/mcp-args"
        "$mca_tool" mcp add -s user "$@" >/dev/null
      else
        set --
        while IFS= read -r h; do
          set -- "$@" --header "$h"
        done <"$PRIVATE_TMP/mcp-headers"
        "$mca_tool" mcp add -s user --transport http "$@" "$mca_name" "$MCP_URL" >/dev/null
      fi
      ;;
    amp)
      if [ "$MCP_TYPE" = "stdio" ]; then
        set -- -- "$MCP_CMD"
        while IFS= read -r a; do
          set -- "$@" "$a"
        done <"$PRIVATE_TMP/mcp-args"
        amp mcp add "$mca_name" "$@" >/dev/null
      else
        if [ -s "$PRIVATE_TMP/mcp-headers" ]; then
          echo "amp: ${C_WARN}note: the amp CLI takes no custom headers; header(s) omitted for $mca_name${C_OFF}" >&2
        fi
        amp mcp add "$mca_name" "$MCP_URL" >/dev/null
      fi
      ;;
  esac
}

mcp_remove_cli() {
  mcr_tool="$1"
  mcr_name="$2"
  case "$mcr_tool" in
    claude) claude mcp remove "$mcr_name" --scope user >/dev/null ;;
    codex) codex mcp remove "$mcr_name" >/dev/null ;;
    gemini | qwen) "$mcr_tool" mcp remove -s user "$mcr_name" >/dev/null ;;
    amp) amp mcp remove "$mcr_name" >/dev/null ;;
  esac
}

mcp_store_applied() {
  mcs_tool="$1"
  mcs_name="$2"
  mcs_spec="$3"
  mcs_dir="$MCP_APPLIED_DIR/$mcs_tool"
  mkdir -p "$mcs_dir"
  MCP_TMP=$(mktemp "$mcs_dir/.agent-sync-applied.XXXXXXXX") || return 1
  cp "$mcs_spec" "$MCP_TMP"
  mv "$MCP_TMP" "$mcs_dir/$mcs_name.spec"
  MCP_TMP=""
}

# Agent-sync updates only entries recorded in its applied-state directory.
# A changed spec is validated under a temporary name before the live entry is
# replaced; if the final add fails, the previous recorded spec is restored.
mcp_push_cli() {
  mcp_tool="$1"
  mcp_name="$2"
  mcp_spec="$3"
  mcp_applied="$MCP_APPLIED_DIR/$mcp_tool/$mcp_name.spec"
  if [ -f "$mcp_applied" ] && cmp -s "$mcp_spec" "$mcp_applied"; then
    return 0
  fi
  if [ ! -f "$mcp_applied" ]; then
    mcp_load_spec "$mcp_spec"
    mcp_add_cli "$mcp_tool" "$mcp_name" || return 1
    mcp_store_applied "$mcp_tool" "$mcp_name" "$mcp_spec"
    return
  fi

  mcp_probe="agent-sync-check-$mcp_name-$$"
  mcp_remove_cli "$mcp_tool" "$mcp_probe" >/dev/null 2>&1 || true
  mcp_load_spec "$mcp_spec"
  if ! mcp_add_cli "$mcp_tool" "$mcp_probe"; then
    mcp_remove_cli "$mcp_tool" "$mcp_probe" >/dev/null 2>&1 || true
    return 1
  fi
  mcp_remove_cli "$mcp_tool" "$mcp_probe" >/dev/null 2>&1 || return 1

  mcp_remove_cli "$mcp_tool" "$mcp_name" >/dev/null 2>&1 || true
  mcp_load_spec "$mcp_spec"
  if mcp_add_cli "$mcp_tool" "$mcp_name"; then
    mcp_store_applied "$mcp_tool" "$mcp_name" "$mcp_spec"
    return
  fi

  echo "$mcp_tool: ${C_WARN}restoring the previous $mcp_name configuration${C_OFF}" >&2
  mcp_load_spec "$mcp_applied"
  if ! mcp_add_cli "$mcp_tool" "$mcp_name"; then
    echo "$mcp_tool: ${C_BOLD}${C_ERR}rollback FAILED${C_OFF} for $mcp_name" >&2
  fi
  return 1
}

mcp_remove_stale_for_tool() {
  mrs_tool="$1"
  mrs_failures=0
  for mrs_applied in "$MCP_APPLIED_DIR/$mrs_tool"/*.spec; do
    [ -f "$mrs_applied" ] || continue
    mrs_name=$(basename "$mrs_applied" .spec)
    [ -f "$MCP_DIR/$mrs_name.spec" ] && continue
    if mcp_remove_cli "$mrs_tool" "$mrs_name"; then
      rm -f "$mrs_applied"
      echo "$mrs_tool: $mrs_name ${C_OK}removed${C_OFF}"
    else
      echo "$mrs_tool: $mrs_name ${C_BOLD}${C_ERR}removal FAILED${C_OFF}" >&2
      mrs_failures=$((mrs_failures + 1))
    fi
  done
  [ "$mrs_failures" -eq 0 ]
}

mcp_record_owned_file() {
  mro_dest="$1"
  mkdir -p "$STATE_DIR"
  if [ -L "$MCP_OWNED" ]; then
    echo "mcp: refusing symbolic-link ownership file: $MCP_OWNED" >&2
    return 1
  fi
  MCP_TMP=$(mktemp "$STATE_DIR/.agent-sync-mcp-owned.XXXXXXXX") || return 1
  [ ! -f "$MCP_OWNED" ] || cat "$MCP_OWNED" >"$MCP_TMP"
  grep -qxF "$mro_dest" "$MCP_TMP" 2>/dev/null || printf '%s\n' "$mro_dest" >>"$MCP_TMP"
  mv "$MCP_TMP" "$MCP_OWNED"
  MCP_TMP=""
}

mcp_require_safe_ownership_file() {
  if [ -L "$MCP_OWNED" ]; then
    echo "mcp: refusing symbolic-link ownership file: $MCP_OWNED" >&2
    return 1
  fi
}

# Rebuild one owned MCP config file wholesale from every registry entry.
# Only files agent-sync created (tracked in MCP_OWNED) are ever rewritten.
mcp_write_owned_file() {
  style="$1"
  dest="$2"
  mcp_require_safe_ownership_file || return 1
  if [ -f "$dest" ] && ! grep -qxF "$dest" "$MCP_OWNED" 2>/dev/null; then
    echo "mcp: ${C_WARN}$dest exists and is not agent-sync managed; add servers there yourself${C_OFF}"
    return 0
  fi
  mkdir -p "$(dirname "$dest")"
  MCP_TMP=$(mktemp "$(dirname "$dest")/.agent-sync-mcp.XXXXXXXX") || {
    echo "mcp: could not create a temporary file beside $dest" >&2
    return 1
  }
  {
    printf '{\n  "mcpServers": {\n'
    first=1
    for spec in "$MCP_DIR"/*.spec; do
      [ -f "$spec" ] || continue
      name=$(basename "$spec" .spec)
      mcp_load_spec "$spec"
      if [ "$style" = "kiro" ] && [ "$MCP_TYPE" != "stdio" ]; then
        echo "kiro: ${C_DIM}$name skipped (kiro's user MCP file is documented for stdio servers only)${C_OFF}" >&2
        continue
      fi
      [ "$first" -eq 1 ] || printf ',\n'
      printf '    "%s": %s' "$(json_escape "$name")" "$(mcp_render_json "$style")"
      first=0
    done
    printf '\n  }\n}\n'
  } >"$MCP_TMP"
  mv "$MCP_TMP" "$dest"
  MCP_TMP=""
  mcp_record_owned_file "$dest"
  echo "mcp: wrote ${C_PATH}$dest${C_OFF}"
}

cmd_mcp() {
  sub="${1:-list}"
  # shift is a POSIX special builtin: its failure is fatal in dash even
  # under || true, so never shift an empty argument list.
  if [ "$#" -gt 0 ]; then shift; fi
  case "$sub" in
    add)
      name="${1:-}"
      if [ -z "$name" ]; then
        echo "${C_WARN}usage:${C_OFF} agent mcp add NAME [--env K=V]... -- COMMAND [ARGS...]" >&2
        echo "       agent mcp add NAME --url URL [--header 'K: V']..." >&2
        exit 2
      fi
      require_safe_name "$name"
      shift
      mkdir -p "$MCP_DIR"
      spec="$MCP_DIR/$name.spec"
      ensure_private_tmp
      tmp="$PRIVATE_TMP/mcp-add-spec"
      : >"$tmp"
      mtype="" murl=""
      while [ "$#" -gt 0 ]; do
        case "$1" in
          --env | --header | --url)
            opt="$1"
            if [ "$#" -lt 2 ]; then
              echo "${C_ERR}agent:${C_OFF} $opt requires a value" >&2
              exit 2
            fi
            case "$2" in *"$NL"*)
              echo "${C_ERR}agent:${C_OFF} $opt values must not contain newlines" >&2
              exit 2
              ;;
            esac
            case "$opt" in
              --env) printf 'env=%s\n' "$2" >>"$tmp" ;;
              --header) printf 'header=%s\n' "$2" >>"$tmp" ;;
              --url)
                mtype="http"
                murl="$2"
                ;;
            esac
            shift 2
            ;;
          --)
            shift
            if [ "$#" -eq 0 ]; then
              echo "${C_ERR}agent:${C_OFF} -- must be followed by a command" >&2
              exit 2
            fi
            mtype="stdio"
            for v in "$@"; do
              case "$v" in *"$NL"*)
                echo "${C_ERR}agent:${C_OFF} command and args must not contain newlines" >&2
                exit 2
                ;;
              esac
            done
            printf 'command=%s\n' "$1" >>"$tmp"
            shift
            while [ "$#" -gt 0 ]; do
              printf 'arg=%s\n' "$1" >>"$tmp"
              shift
            done
            break
            ;;
          *)
            echo "${C_ERR}agent:${C_OFF} unknown mcp add option: $1" >&2
            exit 2
            ;;
        esac
      done
      if [ -z "$mtype" ]; then
        echo "${C_ERR}agent:${C_OFF} mcp add needs either '-- COMMAND' or '--url URL'" >&2
        exit 2
      fi
      MCP_TMP=$(mktemp "$MCP_DIR/.agent-sync-mcp-spec.XXXXXXXX") || {
        echo "${C_ERR}agent:${C_OFF} could not create an MCP registry temporary file" >&2
        exit 1
      }
      {
        printf 'type=%s\n' "$mtype"
        [ -n "$murl" ] && printf 'url=%s\n' "$murl"
        cat "$tmp"
      } >"$MCP_TMP"
      mv "$MCP_TMP" "$spec"
      MCP_TMP=""
      echo "mcp: ${C_OK}registered $name${C_OFF} ${C_DIM}($mtype); run: agent mcp sync${C_OFF}"
      ;;
    list)
      found=0
      for spec in "$MCP_DIR"/*.spec; do
        [ -f "$spec" ] || continue
        mcp_load_spec "$spec"
        if [ "$MCP_TYPE" = "stdio" ]; then
          echo "$(basename "$spec" .spec): ${C_DIM}stdio${C_OFF} $MCP_CMD"
        else
          echo "$(basename "$spec" .spec): ${C_DIM}http${C_OFF} ${C_PATH}$MCP_URL${C_OFF}"
        fi
        found=1
      done
      [ "$found" -eq 1 ] || echo "${C_DIM}no MCP servers registered (agent mcp add NAME -- COMMAND)${C_OFF}"
      ;;
    remove)
      name="${1:-}"
      if [ -z "$name" ]; then
        echo "${C_WARN}usage:${C_OFF} agent mcp remove NAME" >&2
        exit 2
      fi
      require_safe_name "$name"
      rm -f "$MCP_DIR/$name.spec"
      echo "mcp: $name ${C_OK}removed from the registry${C_OFF}${C_DIM}; next mcp sync removes agent-sync-managed copies.${C_OFF}"
      echo "${C_DIM}copies that predate applied-state tracking may need one manual removal${C_OFF}"
      ;;
    sync)
      mcp_require_safe_ownership_file || return 1
      found=0
      mcp_failures=0
      for spec in "$MCP_DIR"/*.spec; do
        [ -f "$spec" ] && found=1
      done
      # CLI-managed tools: detected config dir + the CLI on PATH.
      for tool in claude codex gemini qwen amp; do
          case "$tool" in
            claude) tdir="$AGENT_HOME/.claude" ;;
            codex) tdir="$AGENT_HOME/.codex" ;;
            gemini) tdir="$AGENT_HOME/.gemini" ;;
            qwen) tdir="$AGENT_HOME/.qwen" ;;
            amp) tdir="$AGENT_HOME/.config/amp" ;;
          esac
          if ! target_selected "$tool"; then
            echo "$tool: ${C_DIM}skipped (filtered)${C_OFF}"
            continue
          fi
          if [ ! -d "$tdir" ]; then
            echo "$tool: ${C_DIM}skipped (not installed)${C_OFF}"
            continue
          fi
          if ! command -v "$tool" >/dev/null 2>&1; then
            echo "$tool: ${C_DIM}skipped (CLI not on PATH)${C_OFF}"
            continue
          fi
          if ! mcp_remove_stale_for_tool "$tool"; then
            mcp_failures=$((mcp_failures + 1))
          fi
          for spec in "$MCP_DIR"/*.spec; do
            [ -f "$spec" ] || continue
            name=$(basename "$spec" .spec)
            if mcp_push_cli "$tool" "$name" "$spec"; then
              echo "$tool: $name ${C_OK}configured${C_OFF}"
            else
              echo "$tool: $name ${C_BOLD}${C_ERR}FAILED${C_OFF}" >&2
              mcp_failures=$((mcp_failures + 1))
            fi
          done
      done
      if [ "$found" -eq 0 ]; then
        echo "${C_DIM}no MCP servers registered (agent mcp add NAME -- COMMAND)${C_OFF}"
      fi
      # Dedicated-file tools: rewrite only files agent-sync owns. This runs
      # even with an empty registry, so removing the last server actually
      # removes it from owned files instead of serving it forever.
      if target_selected cursor && [ -d "$AGENT_HOME/.cursor" ]; then
        mcp_write_owned_file cursor "$AGENT_HOME/.cursor/mcp.json"
      fi
      if target_selected windsurf && [ -d "$AGENT_HOME/.codeium" ]; then
        mcp_write_owned_file windsurf "$AGENT_HOME/.codeium/windsurf/mcp_config.json"
      fi
      if target_selected kiro && [ -d "$AGENT_HOME/.kiro" ]; then
        mcp_write_owned_file kiro "$AGENT_HOME/.kiro/settings/mcp.json"
      fi
      echo "${C_DIM}note: zed, opencode, goose and continue keep MCP in shared config files;${C_OFF}"
      echo "${C_DIM}agent-sync will not edit those. See: agent mcp snippet NAME${C_OFF}"
      [ "$mcp_failures" -eq 0 ] || return 1
      ;;
    snippet)
      name="${1:-}"
      if [ -z "$name" ]; then
        echo "${C_WARN}usage:${C_OFF} agent mcp snippet NAME" >&2
        exit 2
      fi
      require_safe_name "$name"
      spec="$MCP_DIR/$name.spec"
      if [ ! -f "$spec" ]; then
        echo "${C_ERR}agent:${C_OFF} unknown MCP server: $name" >&2
        exit 2
      fi
      mcp_load_spec "$spec"
      echo "# zed (~/.config/zed/settings.json)"
      printf '"context_servers": { "%s": %s }\n' "$name" "$(mcp_render_json cursor)"
      echo
      echo "# opencode (~/.config/opencode/opencode.json)"
      if [ "$MCP_TYPE" = "stdio" ]; then
        printf '"mcp": { "%s": { "type": "local", "command": ["%s"' "$name" "$(json_escape "$MCP_CMD")"
        while IFS= read -r a; do
          printf ', "%s"' "$(json_escape "$a")"
        done <"$PRIVATE_TMP/mcp-args"
        printf ']'
        if [ -s "$PRIVATE_TMP/mcp-envs" ]; then
          printf ', "environment": {'
          first=1
          while IFS= read -r e; do
            [ "$first" -eq 1 ] || printf ', '
            printf '"%s": "%s"' "$(json_escape "${e%%=*}")" "$(json_escape "${e#*=}")"
            first=0
          done <"$PRIVATE_TMP/mcp-envs"
          printf '}'
        fi
        printf ' } }\n'
      else
        printf '"mcp": { "%s": { "type": "remote", "url": "%s" } }\n' "$name" "$(json_escape "$MCP_URL")"
      fi
      echo
      echo "# goose (~/.config/goose/config.yaml)"
      echo "extensions:"
      echo "  $name:"
      echo "    enabled: true"
      if [ "$MCP_TYPE" = "stdio" ]; then
        echo "    type: stdio"
        echo "    cmd: $MCP_CMD"
        if [ -s "$PRIVATE_TMP/mcp-args" ]; then
          echo "    args:"
          while IFS= read -r a; do
            echo "      - $a"
          done <"$PRIVATE_TMP/mcp-args"
        fi
        if [ -s "$PRIVATE_TMP/mcp-envs" ]; then
          echo "    envs:"
          while IFS= read -r e; do
            echo "      ${e%%=*}: ${e#*=}"
          done <"$PRIVATE_TMP/mcp-envs"
        fi
      else
        echo "    type: sse"
        echo "    uri: $MCP_URL"
      fi
      echo
      echo "# continue (~/.continue/config.yaml)"
      echo "mcpServers:"
      echo "  - name: $name"
      if [ "$MCP_TYPE" = "stdio" ]; then
        echo "    command: $MCP_CMD"
        if [ -s "$PRIVATE_TMP/mcp-args" ]; then
          echo "    args:"
          while IFS= read -r a; do
            echo "      - $a"
          done <"$PRIVATE_TMP/mcp-args"
        fi
        if [ -s "$PRIVATE_TMP/mcp-envs" ]; then
          echo "    env:"
          while IFS= read -r e; do
            echo "      ${e%%=*}: ${e#*=}"
          done <"$PRIVATE_TMP/mcp-envs"
        fi
      else
        echo "    url: $MCP_URL"
      fi
      ;;
    *)
      echo "${C_WARN}usage:${C_OFF} agent mcp <add|list|remove|sync|snippet>" >&2
      exit 2
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Skills propagation: additively synchronize the canonical skills directory
# ~/.claude/skills) into every agent's user-scope skills directory. The
# mapping follows the gh skill agent registry (cli/cli
# internal/skills/registry/registry.go) and each tool's official docs.
skills_targets() {
  cat <<EOF
codex|$AGENT_HOME/.codex|$AGENT_HOME/.codex/skills
gemini|$AGENT_HOME/.gemini|$AGENT_HOME/.gemini/skills
qwen|$AGENT_HOME/.qwen|$AGENT_HOME/.qwen/skills
cursor|$AGENT_HOME/.cursor|$AGENT_HOME/.cursor/skills
copilot|$AGENT_HOME/.copilot|$AGENT_HOME/.copilot/skills
continue|$AGENT_HOME/.continue|$AGENT_HOME/.continue/skills
kiro|$AGENT_HOME/.kiro|$AGENT_HOME/.kiro/skills
roo|$AGENT_HOME/.roo|$AGENT_HOME/.roo/skills
opencode|$AGENT_HOME/.config/opencode|$AGENT_HOME/.config/opencode/skills
zed|$AGENT_HOME/.config/zed|$AGENT_HOME/.agents/skills
EOF
}

skill_is_owned() {
  grep -qxF "$1" "$SKILLS_OWNED" 2>/dev/null
}

skill_record_owned() {
  sro_dest="$1"
  mkdir -p "$STATE_DIR"
  if [ -L "$SKILLS_OWNED" ]; then
    echo "skills: refusing symbolic-link ownership file: $SKILLS_OWNED" >&2
    return 1
  fi
  SKILL_STATE_TMP=$(mktemp "$STATE_DIR/.agent-sync-skills-owned.XXXXXXXX") || return 1
  [ ! -f "$SKILLS_OWNED" ] || cat "$SKILLS_OWNED" >"$SKILL_STATE_TMP"
  grep -qxF "$sro_dest" "$SKILL_STATE_TMP" 2>/dev/null || printf '%s\n' "$sro_dest" >>"$SKILL_STATE_TMP"
  mv "$SKILL_STATE_TMP" "$SKILLS_OWNED"
  SKILL_STATE_TMP=""
}

skill_sync_one() {
  sso_source="$1"
  sso_dest="$2"
  sso_parent=$(dirname "$sso_dest")
  mkdir -p "$sso_parent"

  if [ -e "$sso_dest" ] || [ -L "$sso_dest" ]; then
    if ! skill_is_owned "$sso_dest"; then
      if [ -d "$sso_dest" ] && ! [ -L "$sso_dest" ] &&
        diff -qr "$sso_source" "$sso_dest" >/dev/null 2>&1; then
        skill_record_owned "$sso_dest"
        return
      fi
      echo "skills: ${C_WARN}collision at $sso_dest; left the existing skill untouched${C_OFF}" >&2
      return 1
    fi
  fi

  SKILL_TMP=$(mktemp -d "$sso_parent/.agent-sync-skill.XXXXXXXX") || return 1
  cp -R "$sso_source/." "$SKILL_TMP/"
  if [ ! -e "$sso_dest" ] && [ ! -L "$sso_dest" ]; then
    mv "$SKILL_TMP" "$sso_dest"
    SKILL_TMP=""
    skill_record_owned "$sso_dest"
    return
  fi

  SKILL_BACKUP=$(mktemp -d "$sso_parent/.agent-sync-skill-backup.XXXXXXXX") || return 1
  rmdir "$SKILL_BACKUP"
  mv "$sso_dest" "$SKILL_BACKUP"
  if mv "$SKILL_TMP" "$sso_dest"; then
    SKILL_TMP=""
    rm -rf "$SKILL_BACKUP"
    SKILL_BACKUP=""
    skill_record_owned "$sso_dest"
    return
  fi
  mv "$SKILL_BACKUP" "$sso_dest"
  SKILL_BACKUP=""
  return 1
}

cmd_skills() {
  sub="${1:-sync}"
  case "$sub" in
    sync) ;;
    *)
      echo "${C_WARN}usage:${C_OFF} agent skills sync" >&2
      exit 2
      ;;
  esac
  if [ ! -d "$SKILLS_SOURCE" ]; then
    echo "${C_ERR}agent:${C_OFF} skills source not found: $SKILLS_SOURCE" >&2
    echo "set AGENT_SYNC_SKILLS_SOURCE to your canonical skills directory" >&2
    exit 1
  fi
  if [ -L "$SKILLS_OWNED" ]; then
    echo "skills: refusing symbolic-link ownership file: $SKILLS_OWNED" >&2
    exit 1
  fi
  # Decide eligibility once, so the per-target loop below cannot disagree
  # with this check.
  ensure_private_tmp
  eligible="$PRIVATE_TMP/skills-eligible"
  : >"$eligible"
  count=0
  linked=0
  for skill in "$SKILLS_SOURCE"/*/; do
    [ -f "$skill/SKILL.md" ] || continue
    skill_path=${skill%/}
    # A symlinked source skill could resolve anywhere, so it is never
    # copied. Skipping it must not block the others: plugin-installed
    # skills are routinely symlinks into a shared skills directory, and
    # failing the whole run made the command unusable wherever one existed.
    if [ -L "$skill_path" ] || [ -L "$skill/SKILL.md" ] ||
      [ -n "$(find "$skill_path" -type l -print -quit)" ]; then
      echo "skills: ${C_DIM}skipping $(basename "$skill_path") (symbolic link in source)${C_OFF}"
      linked=$((linked + 1))
      continue
    fi
    printf '%s\n' "$skill_path" >>"$eligible"
    count=$((count + 1))
  done
  if [ "$count" -eq 0 ]; then
    echo "${C_DIM}no skills found in $SKILLS_SOURCE (a skill is a directory with SKILL.md)${C_OFF}"
    exit 0
  fi
  src_phys=$(physical_path "$SKILLS_SOURCE")
  if [ -z "$src_phys" ]; then
    echo "${C_ERR}agent:${C_OFF} could not resolve the skills source path" >&2
    exit 1
  fi
  skill_failures=0
  while IFS='|' read -r name dir dest; do
    if ! target_selected "$name"; then
      echo "$name: ${C_DIM}skipped (filtered)${C_OFF}"
      continue
    fi
    if [ ! -d "$dir" ]; then
      echo "$name: ${C_DIM}skipped (not installed)${C_OFF}"
      continue
    fi
    mkdir -p "$dest"
    # Compare PHYSICAL paths: a target dir symlinked at (or inside) the
    # source would otherwise let the rm -rf below destroy canonical skills.
    dest_phys=$(physical_path "$dest")
    if [ -z "$dest_phys" ] || [ "$dest_phys" = "$src_phys" ]; then
      echo "$name: ${C_DIM}skipped (skills dir resolves to the source)${C_OFF}"
      continue
    fi
    case "$dest_phys/" in
      "$src_phys"/*)
        echo "$name: ${C_DIM}skipped (skills dir resolves inside the source)${C_OFF}"
        continue
        ;;
    esac
    synced=0
    while IFS= read -r skill_path; do
      [ -n "$skill_path" ] || continue
      sname=$(basename "$skill_path")
      if skill_sync_one "$skill_path" "${dest_phys:?}/$sname"; then
        synced=$((synced + 1))
      else
        skill_failures=$((skill_failures + 1))
      fi
    done <"$eligible"
    echo "$name: ${C_NUM}$synced skill(s)${C_OFF} ${C_DIM}->${C_OFF} ${C_PATH}$dest${C_OFF}"
  done <<EOF
$(skills_targets)
EOF
  if [ "$linked" -gt 0 ]; then
    echo "${C_DIM}source: $SKILLS_SOURCE ($count skill(s); $linked skipped as symbolic links)${C_OFF}"
  else
    echo "${C_DIM}source: $SKILLS_SOURCE ($count skill(s))${C_OFF}"
  fi
  [ "$skill_failures" -eq 0 ] || return 1
}

# ---------------------------------------------------------------------------
# Hook recipes: verified automation snippets that keep memory fresh without
# a daemon. Printed, never installed; settings files belong to the user.
cmd_hooks() {
  tool="${1:-all}"
  case "$tool" in
    claude | all)
      cat <<'EOF'
# Claude Code (~/.claude/settings.json): sync when the session ends
{
  "hooks": {
    "SessionEnd": [
      { "hooks": [ { "type": "command", "command": "agent sync --synthesizer deterministic >&2" } ] }
    ]
  }
}
EOF
      ;;
  esac
  case "$tool" in
    codex | all)
      cat <<'EOF'

# Codex CLI (~/.codex/hooks.json): sync when the agent stops
# (SessionEnd's 3s timeout cap is too tight; Stop is the right event)
{
  "hooks": {
    "Stop": [
      { "hooks": [ { "type": "command", "command": "agent sync --synthesizer deterministic >&2 && printf '{\"continue\":true}\\n'", "timeout": 30 } ] }
    ]
  }
}
EOF
      ;;
  esac
  case "$tool" in
    gemini | all)
      cat <<'EOF'

# Gemini CLI (~/.gemini/settings.json): sync after each completed agent turn
# (SessionEnd is best-effort and does not wait for hooks to finish.)
{
  "hooks": {
    "AfterAgent": [
      { "matcher": "*", "hooks": [ { "name": "AgentSync", "type": "command", "command": "agent sync --synthesizer deterministic >&2 && printf '{}\\n'" } ] }
    ]
  }
}
EOF
      ;;
  esac
  case "$tool" in
    opencode | all)
      cat <<'EOF'

# OpenCode (~/.config/opencode/plugin/agent-sync.js): sync when idle
export const AgentSyncPlugin = async ({ $ }) => ({
  event: async ({ event }) => {
    if (event.type === "session.idle") {
      await $`agent sync --synthesizer deterministic`
    }
  },
})
EOF
      ;;
  esac
  case "$tool" in
    launchd | all)
      cat <<'EOF'

# macOS launchd (~/Library/LaunchAgents/io.agent-sync.compact.plist): keep the
# synthesized file under its byte budget. agent compact exits at once while
# the file is within budget, so a daily run costs a model call only after it
# has grown past it. Load with:
#   launchctl load ~/Library/LaunchAgents/io.agent-sync.compact.plist
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>io.agent-sync.compact</string>
  <key>ProgramArguments</key><array>
    <string>/bin/sh</string><string>-lc</string><string>agent compact</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key><string>/tmp/agent-sync-compact.log</string>
  <key>StandardErrorPath</key><string>/tmp/agent-sync-compact.log</string>
</dict></plist>
EOF
      ;;
  esac
  case "$tool" in
    all)
      cat <<'EOF'

# Everything else (no hook mechanism): cron staleness and size gates
# 0 9 * * * agent status || agent sync --synthesizer deterministic
# 0 9 * * 1 agent compact
EOF
      ;;
    claude | codex | gemini | opencode | launchd) ;;
    *)
      echo "${C_WARN}usage:${C_OFF} agent hooks [claude|codex|gemini|opencode|launchd]" >&2
      exit 2
      ;;
  esac
}

# Colour flags are global, so they are pulled out of the argument list before
# the subcommand ever sees them. Everything after a literal `--` is left
# alone: `agent mcp add NAME -- server --no-color` is the server's flag.
argc=$#
passthrough=0
while [ "$argc" -gt 0 ]; do
  arg="$1"
  shift
  argc=$((argc - 1))
  if [ "$passthrough" -eq 0 ]; then
    case "$arg" in
      --) passthrough=1 ;;
      --color | --colour | --color=always | --colour=always)
        COLOR_MODE=always
        continue
        ;;
      --no-color | --no-colour | --color=never | --colour=never)
        COLOR_MODE=never
        continue
        ;;
      --color=auto | --colour=auto)
        COLOR_MODE=auto
        continue
        ;;
      --color=* | --colour=*)
        # Plain: the palette is not resolved until color_init below.
        echo "agent: unknown colour mode: ${arg#*=} (use always, never or auto)" >&2
        exit 2
        ;;
    esac
  fi
  set -- "$@" "$arg"
done
color_init

case "${1:-help}" in
  sync)
    shift
    cmd_sync "$@"
    ;;
  status) cmd_status ;;
  compact)
    shift
    cmd_compact "$@"
    ;;
  diff) cmd_diff ;;
  doctor) cmd_doctor ;;
  revert) cmd_revert ;;
  link)
    shift
    cmd_link "$@"
    ;;
  pack)
    shift
    cmd_pack "$@"
    ;;
  mcp)
    shift
    cmd_mcp "$@"
    ;;
  skills)
    shift
    cmd_skills "$@"
    ;;
  hooks)
    shift
    cmd_hooks "$@"
    ;;
  targets) cmd_targets ;;
  migrate)
    shift
    cmd_migrate "$@"
    ;;
  gather)
    shift
    cmd_gather "$@"
    ;;
  apply)
    shift
    cmd_apply "$@"
    ;;
  version | --version | -v) echo "agent v$VERSION" ;;
  help | --help | -h) usage ;;
  *)
    echo "${C_ERR}agent:${C_OFF} unknown command: $1" >&2
    usage >&2
    exit 2
    ;;
esac
