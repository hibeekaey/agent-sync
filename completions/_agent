#compdef agent
# zsh completion for agent (agent-sync)

_agent() {
  local -a commands
  commands=(
    'sync:gather, synthesize, and redistribute agent memory'
    'compact:keep the synthesized file under its byte budget'
    'status:per-agent parity check'
    'diff:show stale targets as unified diffs'
    'targets:list sync targets and detection state'
    'doctor:diagnose the setup'
    'migrate:fold one agent'\''s memory stores in'
    'gather:stage memory stores for editing'
    'apply:push staged edits back, then sync'
    'link:make a repo AGENTS.md readable by every agent'
    'revert:restore .orig and .bak backups'
    'pack:shareable memory packs (add/list/update/remove)'
    'mcp:one MCP registry for every tool (add/list/remove/sync/snippet)'
    'skills:additively synchronize canonical skills to every agent'
    'hooks:print automation snippets'
    'help:show usage'
    'version:print the version'
  )
  local -a color_opts
  color_opts=(
    '--color=-[colourise status output]::when:(auto always never)'
    '--no-color[disable colourised status output]'
  )
  if ((CURRENT == 2)); then
    _describe 'command' commands
    _arguments $color_opts
    return
  fi
  case "$words[2]" in
    migrate)
      _values 'agent' claude codex cursor continue windsurf goose
      ;;
    gather)
      _files -/
      ;;
    link)
      _arguments $color_opts \
        '--import[fold native project configs into AGENTS.md]' \
        '1:directory:_files -/'
      ;;
    pack)
      _values 'subcommand' add list update remove
      ;;
    mcp)
      _values 'subcommand' add list remove sync snippet
      ;;
    skills)
      _values 'subcommand' sync
      ;;
    hooks)
      _values 'tool' claude codex gemini opencode launchd
      ;;
    sync)
      _arguments $color_opts \
        '--dry-run[print actions without writing]' \
        '--synthesizer=[synthesis mode]:mode:(auto claude codex deterministic)' \
        '--rewrite[rewrite the whole file instead of folding the new memories in]' \
        '--no-compact[skip the budget pass after a model synthesis]' \
        '--budget=[byte budget for the synthesized file]:bytes' \
        '--claude-model=[Claude model ladder, comma-separated]:models' \
        '--claude-effort=[Claude effort level]:level' \
        '--codex-model=[Codex model ladder, comma-separated]:models' \
        '--codex-effort=[Codex effort level]:level' \
        '--only=[comma-separated targets]' \
        '--skip=[comma-separated targets]'
      ;;
    apply)
      _arguments $color_opts \
        '--dry-run[print actions without writing]' \
        '--synthesizer=[synthesis mode]:mode:(auto claude codex deterministic)' \
        '--rewrite[rewrite the whole file instead of folding the new memories in]' \
        '--no-compact[skip the budget pass after a model synthesis]' \
        '--budget=[byte budget for the synthesized file]:bytes' \
        '--claude-model=[Claude model ladder, comma-separated]:models' \
        '--claude-effort=[Claude effort level]:level' \
        '--codex-model=[Codex model ladder, comma-separated]:models' \
        '--codex-effort=[Codex effort level]:level' \
        '--only=[comma-separated targets]' \
        '--skip=[comma-separated targets]' \
        '1:directory:_files -/'
      ;;
    compact)
      _arguments $color_opts \
        '--dry-run[print the plan without calling a model or writing]' \
        '--force[compact even while within budget]' \
        '--keep-all[forbid forgetting; protect every letter-and-digit token]' \
        '--budget=[byte budget for the synthesized file]:bytes' \
        '--jobs=[sections rewritten concurrently]:count' \
        '--synthesizer=[synthesis mode]:mode:(auto claude codex)' \
        '--claude-model=[Claude model ladder, comma-separated]:models' \
        '--claude-effort=[Claude effort level]:level' \
        '--codex-model=[Codex model ladder, comma-separated]:models' \
        '--codex-effort=[Codex effort level]:level' \
        '--only=[comma-separated targets]' \
        '--skip=[comma-separated targets]'
      ;;
  esac
}

_agent "$@"
